{
	auto_https off
}

http://{$CADDY_LISTEN_ADDR:localhost:8080} {
	encode gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://liki.hk; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	# Allow cross-origin access to OG image for social preview cards
	header /img/og-image.png Cross-Origin-Resource-Policy "cross-origin"

	# Cache static assets
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /css/* Cache-Control "public, max-age=3600, must-revalidate"

	# Application pages with no indexable content
	@noindex path_regexp noindex .*/(chat)(/.*)?$
	header @noindex X-Robots-Tag "noindex"

	log {
		output stdout
		format json
	}

	redir /admin.html /app/admin permanent

	# Protected routes — require same-origin
	handle /api/chat/sessions/*/ag-ui {
		@external {
			header Origin *
			not header Origin http://localhost:8080
		}
		respond @external 403
		reverse_proxy {$LIKI_WEB_HOST:web}:8081 {
			flush_interval -1
		}
	}

	# MCP 直连（与外部 skill 同一路径/协议）：网关剥前缀后转发到 MCP 服务。
	# 与生产 Caddy 的 edge-owned 前缀一致（只占 /engine/mcp*、/counsel/mcp*）。
	@engineMcp path /engine/mcp /engine/mcp/*
	handle @engineMcp {
		uri strip_prefix /engine
		reverse_proxy {$LIKI_ENGINE_MCP_ADDR:localhost:8085}
	}
	@counselMcp path /counsel/mcp /counsel/mcp/*
	handle @counselMcp {
		uri strip_prefix /counsel
		reverse_proxy {$LIKI_COUNSEL_MCP_ADDR:localhost:8086}
	}

	handle /api/* {
		reverse_proxy {$LIKI_WEB_HOST:web}:8081 {
			flush_interval -1
			health_uri /api/health
			health_interval 30s
			health_timeout 5s
		}
	}

	# Standard BCP 47 paths
	redir /zh-Hans /zh-Hans/ 308
	redir /zh-Hant /zh-Hant/ 308
	redir /en /en/ 308

	# ── Bare-path → locale-prefixed redirects (Accept-Language) ──

	# 裸路径 → 本地化页面（Accept-Language 协商）。map 单次求值 + 每条路径单条
	# redir：匹配优先级由 map 规则顺序决定，不依赖同名指令的隐式排序。
	map {header.Accept-Language} {marketing_lang} {
		~(?i)^zh-cn.* zh-Hans
		~(?i)^zh-sg.* zh-Hans
		~(?i)^zh-hans.* zh-Hans
		~(?i)^zh-tw.* zh-Hant
		~(?i)^zh-hk.* zh-Hant
		~(?i)^zh-mo.* zh-Hant
		~(?i)^zh-hant.* zh-Hant
		~(?i)^zh.* zh-Hant
		~(?i)^en.* en
		default zh-Hant
	}

	redir / /{marketing_lang}/ 302
	redir /index.html /{marketing_lang}/ 302
	redir /naming /{marketing_lang}/naming 302
	redir /hepan /{marketing_lang}/natal 302
	redir /about /{marketing_lang}/about 302
	redir /contact /{marketing_lang}/contact 302
	redir /disclaimer /{marketing_lang}/disclaimer 302
	redir /privacy /{marketing_lang}/privacy 302
	redir /terms /{marketing_lang}/terms 302
	redir /divination /{marketing_lang}/divination 302
	redir /fengshui /{marketing_lang}/fengshui 302
	redir /huangli /{marketing_lang}/huangli 302

	# All other routes → Go handles API + static files
	handle {
		reverse_proxy {$LIKI_WEB_HOST:web}:8081
	}
}
