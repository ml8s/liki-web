	}
	redir @baziZhHans /zh-Hans/bazi 302
	redir @baziZhHant /zh-Hant/bazi 302
	redir @baziZh /zh-Hant/bazi 302
	redir @baziEn /en/bazi 302
	redir /bazi /zh-Hant/bazi 302

	# /divination
	@divinationZhHans {
		path /divination
		expression {header.Accept-Language}.startsWith('zh-CN') || {header.Accept-Language}.startsWith('zh-SG') || {header.Accept-Language}.startsWith('zh-Hans')
