	redir /about /zh-Hant/about 302

	# /contact
	@contactZhHans {
		path /contact
		expression {header.Accept-Language}.startsWith('zh-CN') || {header.Accept-Language}.startsWith('zh-SG') || {header.Accept-Language}.startsWith('zh-Hans')
	}
	@contactZhHant {
		path /contact
		expression {header.Accept-Language}.startsWith('zh-TW') || {header.Accept-Language}.startsWith('zh-HK') || {header.Accept-Language}.startsWith('zh-MO') || {header.Accept-Language}.startsWith('zh-Hant')
	}
	@contactZh {
		path /contact
		expression {header.Accept-Language}.startsWith('zh')
	}
	@contactEn {
		path /contact
		expression {header.Accept-Language}.startsWith('en')
	}
	redir @contactZhHans /zh-Hans/contact 302
	redir @contactZhHant /zh-Hant/contact 302
	redir @contactZh /zh-Hant/contact 302
	redir @contactEn /en/contact 302
	redir /contact /zh-Hant/contact 302

	# /disclaimer
	@disclaimerZhHans {
		path /disclaimer
		expression {header.Accept-Language}.startsWith('zh-CN') || {header.Accept-Language}.startsWith('zh-SG') || {header.Accept-Language}.startsWith('zh-Hans')
	}
	@disclaimerZhHant {
		path /disclaimer
		expression {header.Accept-Language}.startsWith('zh-TW') || {header.Accept-Language}.startsWith('zh-HK') || {header.Accept-Language}.startsWith('zh-MO') || {header.Accept-Language}.startsWith('zh-Hant')
	}
	@disclaimerZh {
		path /disclaimer
		expression {header.Accept-Language}.startsWith('zh')
	}
	@disclaimerEn {
		path /disclaimer
		expression {header.Accept-Language}.startsWith('en')
	}
	redir @disclaimerZhHans /zh-Hans/disclaimer 302
	redir @disclaimerZhHant /zh-Hant/disclaimer 302
	redir @disclaimerZh /zh-Hant/disclaimer 302
	redir @disclaimerEn /en/disclaimer 302
	redir /disclaimer /zh-Hant/disclaimer 302

	# /privacy
	@privacyZhHans {
		path /privacy
		expression {header.Accept-Language}.startsWith('zh-CN') || {header.Accept-Language}.startsWith('zh-SG') || {header.Accept-Language}.startsWith('zh-Hans')
	}
	@privacyZhHant {
		path /privacy
		expression {header.Accept-Language}.startsWith('zh-TW') || {header.Accept-Language}.startsWith('zh-HK') || {header.Accept-Language}.startsWith('zh-MO') || {header.Accept-Language}.startsWith('zh-Hant')
	}
	@privacyZh {
