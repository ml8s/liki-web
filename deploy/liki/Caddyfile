{$DOMAIN:localhost} {
	encode gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://liki.hk; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	# Allow cross-origin access to OG image for social preview cards
	header /img/og-image.png Cross-Origin-Resource-Policy "cross-origin"

	# Cache static assets
	header /js/* Cache-Control "public, max-age=3600, must-revalidate"
	header /css/* Cache-Control "public, max-age=31536000, immutable"
	header /i18n/* Cache-Control "public, max-age=60"

	# Application pages with no indexable content
	@noindex path_regexp noindex .*/(chat|report)(/.*)?$
	header @noindex X-Robots-Tag "noindex"

	log {
		output stdout
		format json
	}

	# Console pages are fully externalized. Their tighter script CSP removes
	# inline execution without weakening the marketing pages' existing policy.
	@consolePaths path /kol /scout /admin.html
	header @consolePaths Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://liki.hk; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"

	# Protected routes — require same-origin
	handle /api/agent/* {
		@external {
			header Origin *
			not header Origin https://{$DOMAIN:localhost}
		}
		respond @external 403
		reverse_proxy web:8081 {
			flush_interval -1
		}
	}
	handle /api/orders/*/retry {
		@external {
			header Origin *
			not header Origin https://{$DOMAIN:localhost}
		}
		respond @external 403
		reverse_proxy web:8081
	}

	# JSON-RPC for external AI agents — proxy to engine
	handle /jsonrpc {
		reverse_proxy engine:8082
	}

	# Free API, health — no Origin check
	handle /api/* {
		reverse_proxy web:8081 {
			flush_interval -1
			health_uri /api/health
			health_interval 30s
			health_timeout 5s
		}
	}

	# Standard BCP 47 paths
	redir /zh-Hans /zh-Hans/ 308
	redir /zh-Hant /zh-Hant/ 308
	redir /en /en/ 308

	# Legacy redirects: old locale paths → new BCP 47 paths
	redir /zh /zh-Hans/ 308
	redir /hk /zh-Hant/ 308
	@zh-legacy path_regexp zh ^/zh/(.*)
	redir @zh-legacy /zh-Hans/{re.zh.1} 308
	@hk-legacy path_regexp hk ^/hk/(.*)
	redir @hk-legacy /zh-Hant/{re.hk.1} 308
	# ── Bare-path → locale-prefixed redirects (Accept-Language) ──

	# Root / and /index.html
	@rootZhHans {
		path / /index.html
		expression {header.Accept-Language}.startsWith('zh-CN') || {header.Accept-Language}.startsWith('zh-SG') || {header.Accept-Language}.startsWith('zh-Hans')
	}
	@rootZhHant {
		path / /index.html
		expression {header.Accept-Language}.startsWith('zh-TW') || {header.Accept-Language}.startsWith('zh-HK') || {header.Accept-Language}.startsWith('zh-MO') || {header.Accept-Language}.startsWith('zh-Hant')
	}
	@rootZh {
		path / /index.html
		expression {header.Accept-Language}.startsWith('zh')
	}
	@rootEn {
		path / /index.html
		expression {header.Accept-Language}.startsWith('en')
	}

	redir @rootZhHans /zh-Hans/ 302
	redir @rootZhHant /zh-Hant/ 302
	redir @rootZh /zh-Hant/ 302
	redir @rootEn /en/ 302
	redir / /zh-Hant/ 302
	redir /index.html /zh-Hant/ 302

	# /hepan
	@hepanZhHans {
		path /hepan
		expression {header.Accept-Language}.startsWith('zh-CN') || {header.Accept-Language}.startsWith('zh-SG') || {header.Accept-Language}.startsWith('zh-Hans')
	}
	@hepanZhHant {
		path /hepan
		expression {header.Accept-Language}.startsWith('zh-TW') || {header.Accept-Language}.startsWith('zh-HK') || {header.Accept-Language}.startsWith('zh-MO') || {header.Accept-Language}.startsWith('zh-Hant')
	}
	@hepanZh {
		path /hepan
		expression {header.Accept-Language}.startsWith('zh')
	}
	@hepanEn {
		path /hepan
		expression {header.Accept-Language}.startsWith('en')
	}
	redir @hepanZhHans /zh-Hans/hepan 302
	redir @hepanZhHant /zh-Hant/hepan 302
	redir @hepanZh /zh-Hant/hepan 302
	redir @hepanEn /en/hepan 302
	redir /hepan /zh-Hant/hepan 302

	@localeZhHans {
		path_regexp pages ^/(chat|naming|naming/chat|mingshu|about|contact|disclaimer|privacy|terms|index\.html)?$
		expression {header.Accept-Language}.startsWith('zh-CN') || {header.Accept-Language}.startsWith('zh-SG') || {header.Accept-Language}.startsWith('zh-Hans')
	}
	@localeZhHant {
		path_regexp pages ^/(chat|naming|naming/chat|mingshu|about|contact|disclaimer|privacy|terms|index\.html)?$
		expression {header.Accept-Language}.startsWith('zh-TW') || {header.Accept-Language}.startsWith('zh-HK') || {header.Accept-Language}.startsWith('zh-MO') || {header.Accept-Language}.startsWith('zh-Hant')
	}
	@localeZh {
		path_regexp pages ^/(chat|naming|naming/chat|mingshu|about|contact|disclaimer|privacy|terms|index\.html)?$
		expression {header.Accept-Language}.startsWith('zh')
	}
	@localeEn {
		path_regexp pages ^/(chat|naming|naming/chat|mingshu|about|contact|disclaimer|privacy|terms|index\.html)?$
		expression {header.Accept-Language}.startsWith('en')
	}
	redir @localeZhHans /zh-Hans/{re.pages.1} 302
	redir @localeZhHant /zh-Hant/{re.pages.1} 302
	redir @localeZh /zh-Hant/{re.pages.1} 302
	redir @localeEn /en/{re.pages.1} 302
	redir /chat /zh-Hant/naming/chat 302
	redir /naming /zh-Hant/naming 302
	redir /mingshu /zh-Hant/mingshu 302
	redir /about /zh-Hant/about 302
	redir /contact /zh-Hant/contact 302
	redir /disclaimer /zh-Hant/disclaimer 302
	redir /privacy /zh-Hant/privacy 302
	redir /terms /zh-Hant/terms 302

	# Skills — serve SKILL.md for AI agent discovery
	redir /skills /skills/liki/SKILL.md 308
	header /skills/* Cache-Control "public, max-age=60"

	# All other routes → Go handles API + static files
	handle {
		reverse_proxy web:8081
	}
}
