# Liki Environment Variables
# Copy to .env (project root) and fill in values

# Server
LISTEN_ADDR=:8080
DB_PATH=/var/lib/liki/liki.db

# Domain (for Caddy)
DOMAIN_US=
DOMAIN_CN=

# DeepSeek AI
DEEPSEEK_API_KEY=

# Dodo Payments (国际卡)
DODO_API_KEY=
DODO_WEBHOOK_KEY=
DODO_TEST_MODE=true
DODO_PRODUCT_NAMING=

# 虎皮椒支付 (微信/支付宝)
XUNHU_APPID=
XUNHU_APPSECRET=

# Resend Email
RESEND_API_KEY=
RESEND_FROM=

# Payment
RETURN_URL=

# Cloudflare (optional, for TLS)
CF_API_TOKEN=

# skill 规则引擎 python 子进程的引擎 RPC 地址（容器内指 engine 服务）
LIKI_RPC_URL=http://engine:8082/jsonrpc
