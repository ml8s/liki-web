# Liki Environment Variables
# Copy to .env (project root) and fill in values

# Server
LISTEN_ADDR=:8080
DB_PATH=/var/lib/liki/liki.db

# Domain (for Caddy)
DOMAIN_US=
DOMAIN_CN=

# DeepSeek AI
DEEPSEEK_API_KEY=

# Dodo Payments (国际卡)
DODO_API_KEY=
DODO_WEBHOOK_KEY=
DODO_TEST_MODE=true
DODO_PRODUCT_NAMING=
DODO_PRODUCT_MINGSHU=
DODO_PRODUCT_HEPAN=

# 虎皮椒支付 (微信/支付宝)
XUNHU_APPID=
XUNHU_APPSECRET=

# Alipay AI Pay voluntary payment; empty disables the endpoint.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SELLER_ID=
ALIPAY_SELLER_NAME=Liki
ALIPAY_SERVICE_ID=
ALIPAY_AIPAY_AMOUNT=

# Resend Email
RESEND_API_KEY=
RESEND_FROM=

# Payment
RETURN_URL=
PAYMENTS_WEBHOOK_URL=https://liki.hk/api/payments/webhook

# Cloudflare (optional, for TLS)
CF_API_TOKEN=

# skill 规则引擎 python 子进程的引擎 RPC 地址（容器内指 engine 服务）
LIKI_RPC_URL=http://engine:8082/jsonrpc

# Feedback agent
FEEDBACK_API_KEY=

# Internal metrics endpoint token (empty disables endpoint)
METRICS_TOKEN=
