#!/usr/bin/env bash
set -eo pipefail

# Use project Node version (defined in .nvmrc)
source "$(dirname "$0")/../scripts/node-path.sh"

echo "=== go vet ==="
go vet ./...

echo "=== golangci-lint ==="
if command -v golangci-lint >/dev/null 2>&1; then
  golangci-lint run --timeout=3m
else
  echo "⚠ golangci-lint 未安装，本地跳过 lint（CI 必查）——安装："
  echo "  curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/HEAD/install.sh | sh -s -- -b $(go env GOPATH)/bin"
fi

echo "=== go test ==="
go test ./...

echo "=== html check ==="
node web/scripts/check-html.cjs

echo "=== i18n check ==="
node web/scripts/check-i18n.cjs

echo "=== vitest ==="
if [ -d web/node_modules ]; then
  (cd web && npx vitest run test/)
else
  echo "vitest: skipped (npm install required)"
fi

echo ""
echo "✓ pre-commit ok"
