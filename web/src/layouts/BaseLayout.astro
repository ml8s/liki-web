---
import { t } from '../i18n.ts';
import { v } from '../version.ts';
import LangSwitcher from '../components/LangSwitcher.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  locale: string;
  page: string;
  type?: 'article' | 'brand';
  twitterCard?: string;
}

const {
  locale,
  page,
  type = 'article',
  twitterCard = 'summary',
} = Astro.props;

const pagePath = page === 'index' ? '' : page;
// 站点 origin 随构建环境（site 配置）：生产 https://liki.hk，本地审计 SITE_URL=http://localhost:8080。
const siteOrigin = Astro.site ? Astro.site.origin : 'https://liki.hk';
const canonical = `${siteOrigin}/${locale}/${pagePath ? pagePath + '/' : ''}`;
const ogImage = `${siteOrigin}/img/og-image.png`;
// 标题统一为「<页面名> · <站点名>」；页面名里已经带了站点名（首页 slogan）就不再重复追加。
// SPA 侧同一格式见 web/app/src/utils/documentTitle.ts。
const pageTitle = t(locale, `${page}.title`);
const siteName = t(locale, 'site.name');
const documentTitle = pageTitle.includes(siteName) ? pageTitle : `${pageTitle} · ${siteName}`;
---

<!DOCTYPE html>
<html lang={locale}>
<head>
<meta charset="UTF-8">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">

<link rel="canonical" href={canonical}>
<link rel="alternate" hreflang="zh-Hant" href={`${siteOrigin}/zh-Hant/${pagePath ? pagePath + '/' : ''}`}>
<link rel="alternate" hreflang="zh-Hans" href={`${siteOrigin}/zh-Hans/${pagePath ? pagePath + '/' : ''}`}>
<link rel="alternate" hreflang="en" href={`${siteOrigin}/en/${pagePath ? pagePath + '/' : ''}`}>
<link rel="alternate" hreflang="x-default" href={`${siteOrigin}/zh-Hant/${pagePath ? pagePath + '/' : ''}`}>

<meta name="description" content={t(locale, `${page}.metaDesc`)}>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#111f2e">
<meta name="color-scheme" content="light">
<meta property="og:title" content={t(locale, `${page}.meta.ogTitle`)}>
<meta property="og:description" content={t(locale, `${page}.meta.ogDesc`)}>
<meta property="og:url" content={canonical}>
<meta property="og:type" content="website">
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content={twitterCard}>
<meta name="twitter:title" content={t(locale, `${page}.meta.twitterTitle`)}>
<meta name="twitter:description" content={t(locale, `${page}.meta.twitterDesc`)}>
<meta name="twitter:image" content={ogImage}>

<title>{documentTitle}</title>

<slot name="head" />

<link rel="stylesheet" href={`/css/tokens.css?v=${v}`}>
<link rel="stylesheet" href={`/css/app.css?v=${v}`}>
</head>
<body class="bg-stone-50">

<div class="page-shell">

  <a href="#main" class="skip-link">{t(locale, 'a11y.skipLink')}</a>

  <header class="header-dark page-header">
    <div class="max-w-3xl mx-auto px-4 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href={`/${locale}/`} class="text-xl font-brand tracking-tight brand-link">{t(locale, 'site.brand')}</a>
        <span class="brand-slogan">{t(locale, 'site.slogan')}</span>
      </div>
      <div class="flex items-center gap-3">
        <LangSwitcher locale={locale} />
      </div>
    </div>
  </header>

<main id="main" class={type === 'article' ? 'page-main page-main--py' : 'page-main'} tabindex="-1">
  {type === 'article' ? <div class="page-card"><slot /></div> : <slot />}
</main>

<Footer locale={locale} />

  </div>

  <script>
    import '../scripts/analytics';
  </script>
</body>
</html>
