---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, locales } from '../../i18n.js';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<BaseLayout
  locale={locale}
  page="index"
  heading={t(locale, 'site.brand')}
  type="brand"
  twitterCard="summary_large_image"
>
  <Fragment slot="head">
    <meta name="keywords" content="liki.hk,命理,八字,紫微,起名,风水,奇门遁甲,六爻,黄历">
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Liki",
  "alternateName": "灵机",
  "url": "https://liki.hk",
  "applicationCategory": "UtilityApplication",
  "description": "命理 Skill — 八字、紫微、起名、问卦、风水",
  "keywords": "命理,八字,紫微,起名,风水,奇门遁甲,六爻,黄历",
  "offers": [
    { "@type": "Offer", "name": "灵机起名", "description": "按出生信息五行配字，对话选名" },
    { "@type": "Offer", "name": "灵机命书", "description": "八字·紫微综合命理报告" },
    { "@type": "Offer", "name": "灵机合盘", "description": "双人八字·紫微合盘报告" }
  ],
  "contactPoint": { "@type": "ContactPoint", "email": "hi@liki.hk", "contactType": "客服" },
  "knowsAbout": [
    {"@type": "Thing", "name": "BaZi", "alternateName": "八字", "description": "Four Pillars of Destiny"},
    {"@type": "Thing", "name": "ZiWei", "alternateName": "紫微斗数", "description": "Purple Star Astrology"},
    {"@type": "Thing", "name": "QiMen", "alternateName": "奇门遁甲", "description": "Mysterious Door Escaping Technique"},
    {"@type": "Thing", "name": "LiuYao", "alternateName": "六爻", "description": "Six Lines Divination"},
    {"@type": "Thing", "name": "FengShui", "alternateName": "风水", "description": "Chinese Geomancy"},
    {"@type": "Thing", "name": "HuangLi", "alternateName": "黄历", "description": "Chinese Almanac"}
  ],
  "sameAs": [
    "https://www.wikidata.org/wiki/Q140329242",
    "https://github.com/ml8s/liki",
    "https://x.com/liki_hk",
    "https://t.me/liki_naming",
    "https://zhihu.com/people/liki.hk",
    "https://www.xiaohongshu.com/user/profile/liki_hk"
  ]
}</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Liki",
  "url": "https://liki.hk",
  "about": "Liki 灵机 — 命理 Skill，八字、紫微、起名、问卦、风水"
}</script>
  </Fragment>

  <section class="hero-brand">
    <h1 class="text-center text-4xl md:text-5xl font-serif font-bold text-stone-800 mb-2 tracking-tight">{t(locale, 'index.hero.title')}</h1>
    <p class="text-center text-base text-stone-400 mb-1">{t(locale, 'index.hero.subtitle')}</p>
    <p class="text-center text-sm text-stone-400 mt-6 max-w-xl mx-auto leading-loose">{t(locale, 'index.hero.desc')}</p>
  </section>

  <section class="max-w-2xl mx-auto py-8 px-4">
    <h2 class="text-center text-base font-semibold text-stone-800 mb-6">{t(locale, 'index.features')}</h2>
    <div class="keyword-cloud" id="keyword-cloud">
      <span>精确</span><span>严谨</span><span>可复现</span>
      <span>引擎计算</span><span>排盘</span><span>用神</span>
      <span>大运</span><span>考时</span><span>真太阳时</span>
      <span>双系交叉</span><span>三派聚合</span><span>方法论库</span>
      <span>八字</span><span>紫微</span><span>奇门</span>
      <span>六爻</span><span>玄空</span><span>八宅</span>
      <span>起名</span><span>黄历</span>
    </div>
  </section>

  <section class="max-w-2xl mx-auto py-8 px-4 text-center">
    <h2 class="text-base font-semibold text-stone-800 mb-4">{t(locale, 'index.install.title')}</h2>
    <div class="inline-block text-left">
      <p class="text-xs text-stone-400 mb-2">{t(locale, 'index.install.method1')}</p>
      <pre class="install-cmd mb-4">npx skills add ml8s/liki</pre>
      <p class="text-xs text-stone-400 mb-2">{t(locale, 'index.install.method2')}</p>
      <pre class="install-cmd">npx skills add https://liki.hk/</pre>
    </div>
  </section>
</BaseLayout>
