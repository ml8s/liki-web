---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, locales, birthFieldLabels } from '../../i18n.ts';
import keywords from '../../keywords.json' with { type: 'json' };

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const pageKeywords = [...new Set(['liki.hk', ...(keywords as Record<string, string[]>)[locale]])].join(', ');
// 免费工具都在营销站内；只有“深入解读”才通过 LikiChatCta 进入 App。
const toolHref = (service: string) => service === 'natal'
  ? `/${locale}/natal/#chart-tool`
  : `/${locale}/${service}/#free-tool`;
const quickBirthProps = {
  locale,
  appUrl: `/app/birth-profiles/new?locale=${locale}`,
  labels: {
    ...birthFieldLabels(locale),
    submit: t(locale, 'tool.submit'),
    computing: t(locale, 'tool.computing'),
    error: t(locale, 'tool.error'),
    bazi: t(locale, 'natal.tool.bazi'),
    ziwei: t(locale, 'natal.tool.ziwei'),
    lucky: t(locale, 'natal.tool.lucky'),
    cta: t(locale, 'tool.cta'),
    privacy: t(locale, 'tool.privacy'),
  },
};
const siteUrl = 'https://liki.hk';
const homeSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Liki',
      url: siteUrl,
      sameAs: [
        'https://www.wikidata.org/wiki/Q140329242',
        'https://github.com/ml8s/liki',
        'https://x.com/liki_hk',
        'https://t.me/liki_naming',
        'https://zhihu.com/people/liki.hk',
        'https://www.xiaohongshu.com/user/profile/liki_hk',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Liki',
      inLanguage: locale,
      publisher: { '@id': `${siteUrl}/#organization` },
    },
    {
      '@type': 'ItemList',
      '@id': `${siteUrl}/#services`,
      name: t(locale, 'index.services.title'),
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t(locale, 'index.services.natal.title'), url: `${siteUrl}/${locale}/natal/` },
        { '@type': 'ListItem', position: 2, name: t(locale, 'index.services.liunian.title'), url: `${siteUrl}/${locale}/liunian/` },
        { '@type': 'ListItem', position: 3, name: t(locale, 'index.services.hepan.title'), url: `${siteUrl}/${locale}/hepan/` },
        { '@type': 'ListItem', position: 4, name: t(locale, 'index.services.divination.title'), url: `${siteUrl}/${locale}/divination/` },
        { '@type': 'ListItem', position: 5, name: t(locale, 'index.services.huangli.title'), url: `${siteUrl}/${locale}/huangli/` },
        { '@type': 'ListItem', position: 6, name: t(locale, 'index.services.fengshui.title'), url: `${siteUrl}/${locale}/fengshui/` },
        { '@type': 'ListItem', position: 7, name: t(locale, 'index.services.naming.title'), url: `${siteUrl}/${locale}/naming/` },
      ],
    },
  ],
};
---

<BaseLayout
  locale={locale}
  page="index"
  type="brand"
  twitterCard="summary_large_image"
>
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords}>
    <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
  </Fragment>

  <section class="landing-hero">
    <h1 class="landing-h1">{t(locale, 'index.hero.title')}</h1>
    <p class="landing-sub">{t(locale, 'index.hero.subtitle')}</p>
    <div class="landing-actions">
      <a href="#chart-tool" class="btn-purple">{t(locale, 'index.cta.chart')}</a>
      <a href="#services" class="btn-ghost">{t(locale, 'index.cta.learn')}</a>
    </div>
  </section>

  <section
    id="chart-tool"
    class="landing-chart"
  >
    <h2>{t(locale, 'index.chart.title')}</h2>
    <p>{t(locale, 'natal.tool.intro')}</p>
    <div id="quick-birth-tool" data-props={JSON.stringify(quickBirthProps)}>
    </div>
    <script>
      import '../../scripts/quick-birth-tool';
    </script>
  </section>

  <section class="landing-services" id="services">
    <h2>{t(locale, 'index.services.title')}</h2>
    <div class="service-grid">
      <div class="card">
        <h3 class="font-serif">{t(locale, 'index.services.natal.title')}</h3>
        <p>{t(locale, 'index.services.natal.desc')}</p>
        <a href={toolHref('natal')} class="card-link">{t(locale, 'index.services.cta')}</a>
        <a href={`/${locale}/natal/`} class="card-link card-link-secondary">{t(locale, 'index.services.learnMoreWith', { service: t(locale, 'index.services.natal.title') })}</a>
      </div>
      <div class="card">
        <h3 class="font-serif">{t(locale, 'index.services.liunian.title')}</h3>
        <p>{t(locale, 'index.services.liunian.desc')}</p>
        <a href={toolHref('liunian')} class="card-link">{t(locale, 'index.services.cta')}</a>
        <a href={`/${locale}/liunian/`} class="card-link card-link-secondary">{t(locale, 'index.services.learnMoreWith', { service: t(locale, 'index.services.liunian.title') })}</a>
      </div>
      <div class="card">
        <h3 class="font-serif">{t(locale, 'index.services.hepan.title')}</h3>
        <p>{t(locale, 'index.services.hepan.desc')}</p>
        <a href={toolHref('hepan')} class="card-link">{t(locale, 'index.services.cta')}</a>
        <a href={`/${locale}/hepan/`} class="card-link card-link-secondary">{t(locale, 'index.services.learnMoreWith', { service: t(locale, 'index.services.hepan.title') })}</a>
      </div>
      <div class="card">
        <h3 class="font-serif">{t(locale, 'index.services.divination.title')}</h3>
        <p>{t(locale, 'index.services.divination.desc')}</p>
        <a href={toolHref('divination')} class="card-link">{t(locale, 'index.services.cta')}</a>
        <a href={`/${locale}/divination/`} class="card-link card-link-secondary">{t(locale, 'index.services.learnMoreWith', { service: t(locale, 'index.services.divination.title') })}</a>
      </div>
      <div class="card">
        <h3 class="font-serif">{t(locale, 'index.services.huangli.title')}</h3>
        <p>{t(locale, 'index.services.huangli.desc')}</p>
        <a href={toolHref('huangli')} class="card-link">{t(locale, 'index.services.cta')}</a>
        <a href={`/${locale}/huangli/`} class="card-link card-link-secondary">{t(locale, 'index.services.learnMoreWith', { service: t(locale, 'index.services.huangli.title') })}</a>
      </div>
      <div class="card">
        <h3 class="font-serif">{t(locale, 'index.services.fengshui.title')}</h3>
        <p>{t(locale, 'index.services.fengshui.desc')}</p>
        <a href={toolHref('fengshui')} class="card-link">{t(locale, 'index.services.cta')}</a>
        <a href={`/${locale}/fengshui/`} class="card-link card-link-secondary">{t(locale, 'index.services.learnMoreWith', { service: t(locale, 'index.services.fengshui.title') })}</a>
      </div>
      <div class="card">
        <h3 class="font-serif">{t(locale, 'index.services.naming.title')}</h3>
        <p>{t(locale, 'index.services.naming.desc')}</p>
        <a href={toolHref('naming')} class="card-link">{t(locale, 'index.services.cta')}</a>
        <a href={`/${locale}/naming/`} class="card-link card-link-secondary">{t(locale, 'index.services.learnMoreWith', { service: t(locale, 'index.services.naming.title') })}</a>
      </div>
    </div>
  </section>

  <section class="landing-trust">
    <h2 class="font-serif">{t(locale, 'index.trust.title')}</h2>
    <div class="trust-grid">
      <div class="trust-item"><strong class="font-serif">{t(locale, 'index.trust.engine')}</strong></div>
      <div class="trust-item"><strong class="font-serif">{t(locale, 'index.trust.rules')}</strong></div>
      <div class="trust-item"><strong class="font-serif">{t(locale, 'index.trust.verify')}</strong></div>
    </div>
  </section>

  <section class="landing-ai">
    <h2 class="font-serif">{t(locale, 'index.ai.title')}</h2>
    <p class="text-sm text-stone-400 text-center max-w-2xl mx-auto mb-6">{t(locale, 'index.ai.body')}</p>
    <p class="text-center"><a class="btn-purple" href={`/app?locale=${locale}`}>{t(locale, 'index.ai.cta')}</a></p>
  </section>

  <section class="landing-steps">
    <h2 class="font-serif">{t(locale, 'index.steps.title')}</h2>
    <div class="steps-grid">
      <div class="card step"><span class="step-n">1</span><p>{t(locale, 'index.steps.s1')}</p></div>
      <div class="card step"><span class="step-n">2</span><p>{t(locale, 'index.steps.s2')}</p></div>
      <div class="card step"><span class="step-n">3</span><p>{t(locale, 'index.steps.s3')}</p></div>
      <div class="card step"><span class="step-n">4</span><p>{t(locale, 'index.steps.s4')}</p></div>
    </div>
  </section>

  <section class="landing-cta">
    <p class="font-serif">{t(locale, 'index.cta.bottom')}</p>
    <a href="#chart-tool" class="btn-purple">{t(locale, 'index.cta.chart')}</a>
  </section>
</BaseLayout>
