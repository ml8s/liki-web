---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LikiChatCta from '../../components/LikiChatCta.astro';
import { t, locales } from '../../i18n.js';
import { v } from '../../version.js';
import keywords from '../../keywords.json' with { type: 'json' };

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const pageKeywords = [...new Set(['liki.hk', ...keywords[locale]])].join(', ');
const siteUrl = 'https://liki.hk';
const homeSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Liki',
      url: siteUrl,
      sameAs: [
        'https://www.wikidata.org/wiki/Q140329242',
        'https://github.com/ml8s/liki',
        'https://x.com/liki_hk',
        'https://t.me/liki_naming',
        'https://zhihu.com/people/liki.hk',
        'https://www.xiaohongshu.com/user/profile/liki_hk',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Liki',
      inLanguage: locale,
      publisher: { '@id': `${siteUrl}/#organization` },
    },
    {
      '@type': 'ItemList',
      '@id': `${siteUrl}/#services`,
      name: t(locale, 'index.services.title'),
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t(locale, 'index.services.naming.title'), url: `${siteUrl}/${locale}/naming/` },
        { '@type': 'ListItem', position: 2, name: t(locale, 'index.services.bazi.title'), url: `${siteUrl}/${locale}/bazi/` },
        { '@type': 'ListItem', position: 3, name: t(locale, 'index.services.mingshu.title'), url: `${siteUrl}/${locale}/mingshu/` },
        { '@type': 'ListItem', position: 4, name: t(locale, 'index.services.divination.title'), url: `${siteUrl}/${locale}/divination/` },
        { '@type': 'ListItem', position: 5, name: t(locale, 'index.services.fengshui.title'), url: `${siteUrl}/${locale}/fengshui/` },
        { '@type': 'ListItem', position: 6, name: t(locale, 'index.services.bond.title'), url: `${siteUrl}/${locale}/hepan/` },
      ],
    },
  ],
};
---

<BaseLayout
  locale={locale}
  page="index"
  type="brand"
  twitterCard="summary_large_image"
>
  <Fragment slot="head">
    <meta name="keywords" content={pageKeywords}>
    <script type="application/ld+json" set:html={JSON.stringify(homeSchema)} />
  </Fragment>

  <section class="landing-hero">
    <h1 class="landing-h1">{t(locale, 'index.hero.title')}</h1>
    <p class="landing-sub">{t(locale, 'index.hero.subtitle')}</p>
    <div class="landing-actions">
      <LikiChatCta locale={locale} labelKey="index.cta.paipan" />
      <a href="#services" class="btn-ghost">{t(locale, 'index.cta.learn')}</a>
    </div>
  </section>

  <section class="landing-paipan">
    <h2>{t(locale, 'index.paipan.title')}</h2>
    <p>{t(locale, 'index.paipan.desc')}</p>
    <form class="paipan-hook" id="paipanHook">
      <input name="date" type="date" required aria-label={t(locale, 'index.paipan.date')} />
      <input name="time" type="time" required aria-label={t(locale, 'index.paipan.time')} />
      <select name="gender" required aria-label={t(locale, 'index.paipan.gender')}>
        <option value="" disabled selected>{t(locale, 'index.paipan.gender_placeholder')}</option>
        <option value="female">{t(locale, 'index.paipan.female')}</option>
        <option value="male">{t(locale, 'index.paipan.male')}</option>
      </select>
      <button type="submit" class="btn-purple">{t(locale, 'index.cta.paipan')}</button>
    </form>
    <p class="paipan-hint">{t(locale, 'index.paipan.hint')}</p>
    <script>
      import '../../scripts/paipan-hook';
    </script>
  </section>

  <section class="landing-services" id="services">
    <h2>{t(locale, 'index.services.title')}</h2>
    <div class="service-grid">
      <div class="card">
        <h3 class="font-serif">{t(locale, 'index.services.naming.title')}</h3>
        <p>{t(locale, 'index.services.naming.desc')}</p>
        <LikiChatCta locale={locale} scenario="naming" labelKey="index.services.cta" class="card-link" />
        <a href={`/${locale}/naming/`} class="card-link card-link-secondary">{t(locale, 'index.services.learnMore')}</a>
      </div>
      <div class="card">
        <h3 class="font-serif">{t(locale, 'index.services.bazi.title')}</h3>
        <p>{t(locale, 'index.services.bazi.desc')}</p>
        <LikiChatCta locale={locale} service="bazi" labelKey="index.services.cta" class="card-link" />
        <a href={`/${locale}/bazi/`} class="card-link card-link-secondary">{t(locale, 'index.services.learnMore')}</a>
      </div>
      <div class="card">
        <h3 class="font-serif">{t(locale, 'index.services.mingshu.title')}</h3>
        <p>{t(locale, 'index.services.mingshu.desc')}</p>
        <LikiChatCta locale={locale} scenario="mingshu" labelKey="index.services.cta" class="card-link" />
        <a href={`/${locale}/mingshu/`} class="card-link card-link-secondary">{t(locale, 'index.services.learnMore')}</a>
      </div>
      <div class="card">
        <h3 class="font-serif">{t(locale, 'index.services.divination.title')}</h3>
        <p>{t(locale, 'index.services.divination.desc')}</p>
        <LikiChatCta locale={locale} service="divination" labelKey="index.services.cta" class="card-link" />
        <a href={`/${locale}/divination/`} class="card-link card-link-secondary">{t(locale, 'index.services.learnMore')}</a>
      </div>
      <div class="card">
        <h3 class="font-serif">{t(locale, 'index.services.fengshui.title')}</h3>
        <p>{t(locale, 'index.services.fengshui.desc')}</p>
        <LikiChatCta locale={locale} service="fengshui" labelKey="index.services.cta" class="card-link" />
        <a href={`/${locale}/fengshui/`} class="card-link card-link-secondary">{t(locale, 'index.services.learnMore')}</a>
      </div>
      <div class="card">
        <h3 class="font-serif">{t(locale, 'index.services.bond.title')}</h3>
        <p>{t(locale, 'index.services.bond.desc')}</p>
        <LikiChatCta locale={locale} scenario="hepan" labelKey="index.services.cta" class="card-link" />
        <a href={`/${locale}/hepan/`} class="card-link card-link-secondary">{t(locale, 'index.services.learnMore')}</a>
      </div>
    </div>
  </section>

  <section class="landing-trust">
    <h2 class="font-serif">{t(locale, 'index.trust.title')}</h2>
    <div class="trust-grid">
      <div class="trust-item"><strong class="font-serif">{t(locale, 'index.trust.engine')}</strong></div>
      <div class="trust-item"><strong class="font-serif">{t(locale, 'index.trust.rules')}</strong></div>
      <div class="trust-item"><strong class="font-serif">{t(locale, 'index.trust.verify')}</strong></div>
    </div>
  </section>

  <section class="landing-steps">
    <h2 class="font-serif">{t(locale, 'index.steps.title')}</h2>
    <div class="steps-grid">
      <div class="card step"><span class="step-n">1</span><p>{t(locale, 'index.steps.s1')}</p></div>
      <div class="card step"><span class="step-n">2</span><p>{t(locale, 'index.steps.s2')}</p></div>
      <div class="card step"><span class="step-n">3</span><p>{t(locale, 'index.steps.s3')}</p></div>
      <div class="card step"><span class="step-n">4</span><p>{t(locale, 'index.steps.s4')}</p></div>
    </div>
  </section>

  <section class="landing-cta">
    <p class="font-serif">{t(locale, 'index.cta.bottom')}</p>
    <LikiChatCta locale={locale} labelKey="index.cta.paipan" />
  </section>
</BaseLayout>
