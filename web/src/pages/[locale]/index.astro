---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, locales } from '../../i18n.js';
import keywords from '../../keywords.json' with { type: 'json' };

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<BaseLayout
  locale={locale}
  page="index"
  heading={t(locale, 'site.brand')}
  type="brand"
  twitterCard="summary_large_image"
>
  <Fragment slot="head">
    <meta name="keywords" content="liki.hk,命理,八字,紫微,起名,风水,奇门遁甲,六爻,黄历">
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Liki",
  "alternateName": "灵机",
  "url": "https://liki.hk",
  "applicationCategory": "UtilityApplication",
  "description": "命理 Skill — 八字、紫微、起名、问卦、风水",
  "keywords": "命理,八字,紫微,起名,风水,奇门遁甲,六爻,黄历",
  "offers": [
    { "@type": "Offer", "name": "灵机起名", "description": "按出生信息五行配字，对话选名" },
    { "@type": "Offer", "name": "灵机命书", "description": "八字·紫微综合命理报告" },
    { "@type": "Offer", "name": "灵机合盘", "description": "双人八字·紫微合盘报告" }
  ],
  "contactPoint": { "@type": "ContactPoint", "email": "hi@liki.hk", "contactType": "客服" },
  "knowsAbout": [
    {"@type": "Thing", "name": "BaZi", "alternateName": "八字", "description": "Four Pillars of Destiny"},
    {"@type": "Thing", "name": "ZiWei", "alternateName": "紫微斗数", "description": "Purple Star Astrology"},
    {"@type": "Thing", "name": "QiMen", "alternateName": "奇门遁甲", "description": "Mysterious Door Escaping Technique"},
    {"@type": "Thing", "name": "LiuYao", "alternateName": "六爻", "description": "Six Lines Divination"},
    {"@type": "Thing", "name": "FengShui", "alternateName": "风水", "description": "Chinese Geomancy"},
    {"@type": "Thing", "name": "HuangLi", "alternateName": "黄历", "description": "Chinese Almanac"}
  ],
  "sameAs": [
    "https://www.wikidata.org/wiki/Q140329242",
    "https://github.com/ml8s/liki",
    "https://x.com/liki_hk",
    "https://t.me/liki_naming",
    "https://zhihu.com/people/liki.hk",
    "https://www.xiaohongshu.com/user/profile/liki_hk"
  ]
}</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Liki",
  "url": "https://liki.hk",
  "about": "Liki 灵机 — 命理 Skill，八字、紫微、起名、问卦、风水"
}</script>
  </Fragment>

  <section class="hero-brand mt-8">
    <h1 class="text-center text-4xl md:text-5xl font-serif font-bold text-stone-800 tracking-tight">{t(locale, 'index.hero.title')}</h1>
    <p class="text-center text-3xl font-serif text-stone-600 mt-4">{t(locale, 'site.slogan')}</p>
    <p class="text-center text-xl md:text-2xl text-stone-400 mt-3">{t(locale, 'index.hero.subtitle')}</p>
  </section>

  <div class="max-w-2xl mx-auto px-4 pb-8 text-center space-y-6">
    <p class="text-xs text-stone-400 mb-2">{t(locale, 'index.install.method1')}</p>
    <div class="install-block">
      <pre class="install-cmd">npx skills add ml8s/liki</pre>
      <button class="copy-btn" data-cmd="npx skills add ml8s/liki" aria-label="复制命令">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
      </button>
    </div>
    <p class="text-xs text-stone-400 mb-2">{t(locale, 'index.install.method2')}</p>
    <div class="install-block">
      <pre class="install-cmd">npx skills add https://liki.hk/</pre>
      <button class="copy-btn" data-cmd="npx skills add https://liki.hk/" aria-label="复制命令">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
      </button>
    </div>
  </div>

  <div id="kw-bg" aria-hidden="true">
    {keywords.en.map(k => <span>{k}</span>)}
    {keywords['zh-Hans'].map(k => <span>{k}</span>)}
    {keywords['zh-Hant'].map(k => <span>{k}</span>)}
  </div>
  <script is:inline>
  (function(){
    var items = document.querySelectorAll('#kw-bg span');
    for (var i = 0; i < items.length; i++) {
      items[i].style.cssText = 'position:absolute;left:'+(Math.random()*85+7)+'%;top:'+(Math.random()*90+5)+'%;font-size:'+(12+Math.random()*14)+'px;color:#16775d;opacity:0.06;white-space:nowrap;pointer-events:none;user-select:none;transform:translateX(-50%) rotate('+(Math.random()*60-30)+'deg)';
    }
    // ── Copy buttons (icon only) ──
    var btns = document.querySelectorAll('.copy-btn');
    for (var i = 0; i < btns.length; i++) {
      btns[i].addEventListener('click', function() {
        var cmd = this.getAttribute('data-cmd');
        if (!cmd) return;
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(cmd).then(function() {
            var orig = this.innerHTML;
            this.innerHTML = '<span class="text-xs">✓</span>';
            var self = this;
            setTimeout(function() { self.innerHTML = orig; }, 1500);
          }.bind(this)).catch(function() {});
        }
      });
    }
  })();
  </script>
</BaseLayout>