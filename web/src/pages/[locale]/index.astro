---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, locales } from '../../i18n.js';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<BaseLayout
  locale={locale}
  page="index"
  heading={t(locale, 'site.brand')}
  type="brand"
  twitterCard="summary_large_image"
>
  <Fragment slot="head">
    <meta name="keywords" content="liki.hk,命理,八字,紫微,起名,问卦,风水,免费排盘,专业解读">
  </Fragment>

  <section class="landing-hero">
    <h1 class="landing-h1">{t(locale, 'index.hero.title')}</h1>
    <p class="landing-sub">{t(locale, 'index.hero.subtitle')}</p>
    <div class="landing-actions">
      <a href="/app" class="btn-purple">{t(locale, 'index.cta.paipan')}</a>
      <a href="#services" class="btn-ghost">{t(locale, 'index.cta.learn')}</a>
    </div>
  </section>

  <section class="landing-paipan">
    <h2>{t(locale, 'index.paipan.title')}</h2>
    <p>{t(locale, 'index.paipan.desc')}</p>
    <form class="paipan-hook" id="paipanHook">
      <input name="date" type="date" required aria-label={t(locale, 'index.paipan.date')} />
      <input name="time" type="time" required aria-label={t(locale, 'index.paipan.time')} />
      <select name="gender" aria-label={t(locale, 'index.paipan.gender')}>
        <option value="female">{t(locale, 'index.paipan.female')}</option>
        <option value="male">{t(locale, 'index.paipan.male')}</option>
      </select>
      <button type="submit" class="btn-purple">{t(locale, 'index.cta.paipan')}</button>
    </form>
    <p class="paipan-hint">{t(locale, 'index.paipan.hint')}</p>
    <script is:inline>
    (function(){
      var f = document.getElementById('paipanHook');
      if (!f) return;
      f.addEventListener('submit', function(e){
        e.preventDefault();
        var date = f.date.value, time = f.time.value, gender = f.gender.value;
        if (!date || !time) return;
        try {
          sessionStorage.setItem('liki-draft', JSON.stringify({
            birth_date: date, birth_time: time, gender: gender, calendar: 'solar'
          }));
        } catch (_) {}
        location.href = '/app/profiles/new';
      });
    })();
    </script>
  </section>

  <section class="landing-services" id="services">
    <h2>{t(locale, 'index.services.title')}</h2>
    <div class="service-grid">
      <div class="card">
        <h3 class="font-serif">{t(locale, 'index.services.naming.title')}</h3>
        <p>{t(locale, 'index.services.naming.desc')}</p>
        <a href="/app" class="card-link">{t(locale, 'index.services.cta')}</a>
      </div>
      <div class="card">
        <h3 class="font-serif">{t(locale, 'index.services.bazi.title')}</h3>
        <p>{t(locale, 'index.services.bazi.desc')}</p>
        <a href="/app" class="card-link">{t(locale, 'index.services.cta')}</a>
      </div>
      <div class="card">
        <h3 class="font-serif">{t(locale, 'index.services.divination.title')}</h3>
        <p>{t(locale, 'index.services.divination.desc')}</p>
        <a href="/app" class="card-link">{t(locale, 'index.services.cta')}</a>
      </div>
      <div class="card">
        <h3 class="font-serif">{t(locale, 'index.services.fengshui.title')}</h3>
        <p>{t(locale, 'index.services.fengshui.desc')}</p>
        <a href="/app" class="card-link">{t(locale, 'index.services.cta')}</a>
      </div>
    </div>
  </section>

  <section class="landing-trust">
    <h2 class="font-serif">{t(locale, 'index.trust.title')}</h2>
    <div class="trust-grid">
      <div class="trust-item"><strong class="font-serif">{t(locale, 'index.trust.engine')}</strong></div>
      <div class="trust-item"><strong class="font-serif">{t(locale, 'index.trust.rules')}</strong></div>
      <div class="trust-item"><strong class="font-serif">{t(locale, 'index.trust.verify')}</strong></div>
    </div>
  </section>

  <section class="landing-steps">
    <h2 class="font-serif">{t(locale, 'index.steps.title')}</h2>
    <div class="steps-grid">
      <div class="card step"><span class="step-n">1</span><p>{t(locale, 'index.steps.s1')}</p></div>
      <div class="card step"><span class="step-n">2</span><p>{t(locale, 'index.steps.s2')}</p></div>
      <div class="card step"><span class="step-n">3</span><p>{t(locale, 'index.steps.s3')}</p></div>
      <div class="card step"><span class="step-n">4</span><p>{t(locale, 'index.steps.s4')}</p></div>
    </div>
  </section>

  <section class="landing-cta">
    <p class="font-serif">{t(locale, 'index.cta.bottom')}</p>
    <a href="/app" class="btn-purple">{t(locale, 'index.cta.paipan')}</a>
  </section>
</BaseLayout>