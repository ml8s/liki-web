---
import ScenarioLanding from '../../components/ScenarioLanding.astro';
import { t, locales } from '../../i18n.js';
import { v } from '../../version.js';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const demo = locale === 'en' ? null : JSON.parse(readFileSync(join(process.cwd(), 'js/hepan-report-demo.json'), 'utf-8'));
const benefits = ['chemistry', 'friction', 'communication', 'timing'].map(key => `scenario.hepan.benefit.${key}`);
const steps = ['s1', 's2', 's3', 's4'].map(key => `scenario.steps.${key}`);
const questions = ['q1', 'q2', 'q3'].map(key => `scenario.hepan.${key}`);
const faqs = ['paid', 'data', 'accuracy'].map(key => ({
  questionKey: `scenario.faq.${key}.q`,
  answerKey: `scenario.faq.${key}.a`,
}));
const staticSections = ['overview', 'wuxing', 'dayMaster', 'branches', 'rating']
  .map(key => ({
    title: t(locale, `scenario.hepan.static.${key}.title`),
    body: t(locale, `scenario.hepan.static.${key}.body`),
  }));

---

<ScenarioLanding
  locale={locale}
  page="hepan"
  scenario="hepan"
  titleKey="scenario.hepan.title"
  subtitleKey="scenario.hepan.subtitle"
  benefitsTitleKey="scenario.hepan.benefitsTitle"
  benefitKeys={benefits}
  exampleTitleKey="scenario.hepan.exampleTitle"
  stepsTitleKey="scenario.stepsTitle"
  stepKeys={steps}
  questionsTitleKey="scenario.hepan.questionsTitle"
  questionKeys={questions}
  faqTitleKey="scenario.faqTitle"
  faqs={faqs}
>
  <div class="scenario-static-index">
    {staticSections.map(section => (
      <details>
        <summary>{section.title}</summary>
        <p>{section.body}</p>
      </details>
    ))}
  </div>
  {demo && (
    <>
      <div class="scenario-report-frame" tabindex="0">
        <p class="scenario-demo-note">{t(locale, 'scenario.demoNote')}</p>
        <div id="hepan-report-example"></div>
      </div>
      <script is:inline defer src={`/js/marked.min.js?v=${v}`}></script>
      <script is:inline defer src={`/js/purify.min.js?v=${v}`}></script>
      <script is:inline defer src={`/js/render-report.js?v=${v}`}></script>
      <script is:inline type="application/json" id="hepan-demo-data" set:html={JSON.stringify(demo)}></script>
      <script is:inline>
        document.addEventListener('DOMContentLoaded', function() {
          var target = document.getElementById('hepan-report-example');
          var source = document.getElementById('hepan-demo-data');
          if (!target || !source || !window.renderReport) return;
          try {
            target.innerHTML = window.renderReport(JSON.parse(source.textContent));
          } catch (error) {
            target.textContent = target.getAttribute('data-error') || 'Render error';
          }
        });
      </script>
    </>
  )}
</ScenarioLanding>
