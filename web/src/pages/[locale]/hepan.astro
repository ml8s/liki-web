---
import IntentLanding from '../../components/IntentLanding.astro';
import SeoTopics from '../../components/SeoTopics.astro';
import { t, locales, birthFieldLabels } from '../../i18n.ts';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const ns = 'intent.hepan';
const benefits = ['chemistry', 'friction', 'communication', 'timing'].map(key => `${ns}.benefit.${key}`);
const steps = ['s1', 's2', 's3', 's4'].map(key => `intent.steps.${key}`);
const questions = ['q1', 'q2', 'q3'].map(key => `${ns}.${key}`);
const staticSections = ['overview', 'dayMaster', 'branches', 'zodiac', 'wuxing'].map(key => ({
  title: t(locale, `${ns}.static.${key}.title`),
  body: t(locale, `${ns}.static.${key}.body`),
}));
const faqs = [
  { questionKey: 'hepan.faq.overview.q', answerKey: 'hepan.faq.overview.a' },
  { questionKey: 'hepan.faq.zodiac.q', answerKey: 'hepan.faq.zodiac.a' },
  { questionKey: 'hepan.faq.friction.q', answerKey: 'hepan.faq.friction.a' },
  { questionKey: 'intent.faq.accuracy.q', answerKey: 'intent.faq.accuracy.a' },
];
const topics = ['a', 'b', 'c'].map(k => ({
  titleKey: `hepan.topics.${k}.title`,
  bodyKey: `hepan.topics.${k}.body`,
}));
const birthLabels = birthFieldLabels(locale);
const toolProps = {
  locale,
  appUrl: `/app/birth-profiles/new?locale=${locale}`,
  labels: {
    ...birthLabels,
    personA: t(locale, 'hepan.tool.personA'),
    personB: t(locale, 'hepan.tool.personB'),
    you: t(locale, 'hepan.tool.you'),
    submit: t(locale, 'tool.submit'),
    computing: t(locale, 'tool.computing'),
    error: t(locale, 'tool.error'),
    result: t(locale, 'hepan.tool.result'),
    resultIntro: t(locale, 'hepan.tool.resultIntro'),
    cta: t(locale, 'tool.cta'),
    privacy: t(locale, 'tool.privacy'),
    consent: t(locale, 'hepan.tool.consent'),
    consentRequired: t(locale, 'hepan.tool.consentRequired'),
  },
};
---

<IntentLanding
  locale={locale}
  page="hepan"
  intent="hepan"
  titleKey={`${ns}.title`}
  subtitleKey={`${ns}.subtitle`}
  benefitsTitleKey={`${ns}.benefitsTitle`}
  benefitKeys={benefits}
  exampleTitleKey={`${ns}.exampleTitle`}
  stepsTitleKey="intent.stepsTitle"
  stepKeys={steps}
  questionsTitleKey={`${ns}.questionsTitle`}
  questionKeys={questions}
  faqTitleKey="intent.faqTitle"
  faqs={faqs}
>
  <Fragment slot="tool">
    <h2>{t(locale, 'hepan.tool.title')}</h2>
    <p>{t(locale, 'hepan.tool.intro')}</p>
    <div id="hepan-tool" data-props={JSON.stringify(toolProps)}>
    </div>
  </Fragment>
  <div class="intent-static-index">
    {staticSections.map(section => (
      <details>
        <summary>{section.title}</summary>
        <p>{section.body}</p>
      </details>
    ))}
  </div>
  <Fragment slot="topics">
    <SeoTopics
      locale={locale}
      titleKey="hepan.topics.title"
      items={topics}
      linkHref={`/${locale}/natal/`}
      linkKey="hepan.topics.link"
    />
  </Fragment>
</IntentLanding>

<script>
  import '../../scripts/hepan-tool';
</script>
