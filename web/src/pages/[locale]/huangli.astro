---
import IntentLanding from '../../components/IntentLanding.astro';
import SeoTopics from '../../components/SeoTopics.astro';
import { birthFieldLabels, t, locales } from '../../i18n.ts';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const ns = 'intent.huangli';
const benefits = ['structure', 'insight', 'timing', 'action'].map(key => `${ns}.benefit.${key}`);
const steps = ['s1', 's2', 's3', 's4'].map(key => `intent.steps.${key}`);
const questions = ['q1', 'q2', 'q3'].map(key => `${ns}.${key}`);
const faqs = [
  { questionKey: 'huangli.faq.accuracy.q', answerKey: 'huangli.faq.accuracy.a' },
  { questionKey: 'huangli.faq.move.q', answerKey: 'huangli.faq.move.a' },
  { questionKey: 'huangli.faq.wedding.q', answerKey: 'huangli.faq.wedding.a' },
  { questionKey: 'huangli.faq.opening.q', answerKey: 'huangli.faq.opening.a' },
];
const topics = ['a', 'b', 'c'].map(k => ({
  titleKey: `huangli.topics.${k}.title`,
  bodyKey: `huangli.topics.${k}.body`,
}));
const staticSections = ['focus', 'method', 'output'].map(key => ({
  title: t(locale, `${ns}.static.${key}.title`),
  body: t(locale, `${ns}.static.${key}.body`),
}));
const toolProps = {
  locale,
  appUrl: `/app?service=huangli&locale=${locale}`,
  labels: {
    ...birthFieldLabels(locale),
    submit: t(locale, 'tool.submit'),
    computing: t(locale, 'tool.computing'),
    error: t(locale, 'tool.error'),
    resultIntro: t(locale, 'huangli.tool.resultIntro'),
    selectedHint: t(locale, 'huangli.tool.selectedHint'),
    personalTitle: t(locale, 'huangli.tool.personalTitle'),
    personalIntro: t(locale, 'huangli.tool.personalIntro'),
    personalCompute: t(locale, 'huangli.tool.personalCompute'),
    personalPrivacy: t(locale, 'huangli.tool.personalPrivacy'),
    cta: t(locale, 'tool.cta'),
    privacy: t(locale, 'tool.privacy'),
  },
};
---

<IntentLanding
  locale={locale}
  page="huangli"
  service="huangli"
  titleKey={`${ns}.title`}
  subtitleKey={`${ns}.subtitle`}
  benefitsTitleKey={`${ns}.benefitsTitle`}
  benefitKeys={benefits}
  exampleTitleKey={`${ns}.exampleTitle`}
  stepsTitleKey="intent.stepsTitle"
  stepKeys={steps}
  questionsTitleKey={`${ns}.questionsTitle`}
  questionKeys={questions}
  faqTitleKey="intent.faqTitle"
  faqs={faqs}
>
  <Fragment slot="tool">
    <h2>{t(locale, 'huangli.tool.title')}</h2>
    <p>{t(locale, 'huangli.tool.intro')}</p>
    <div id="huangli-tool" data-props={JSON.stringify(toolProps)}>
    </div>
  </Fragment>
  <div class="intent-static-index">
    {staticSections.map(section => (
      <details>
        <summary>{section.title}</summary>
        <p>{section.body}</p>
      </details>
    ))}
  </div>
  <div class="intent-content-blocks">
    <article>
      <h3>{t(locale, 'huangli.taisui.title')}</h3>
      <p>{t(locale, 'huangli.taisui.body')}</p>
    </article>
    <article>
      <h3>{t(locale, 'huangli.daily.title')}</h3>
      <p>{t(locale, 'huangli.daily.body')}</p>
    </article>
    <article>
      <h3>{t(locale, 'huangli.calendar.title')}</h3>
      <p>{t(locale, 'huangli.calendar.body')}</p>
    </article>
    <article>
      <h3>{t(locale, 'huangli.events.title')}</h3>
      <p>{t(locale, 'huangli.events.body')}</p>
    </article>
  </div>
  <Fragment slot="topics">
    <SeoTopics
      locale={locale}
      titleKey="huangli.topics.title"
      items={topics}
      linkHref={`/${locale}/natal/`}
      linkKey="huangli.topics.link"
    />
  </Fragment>
</IntentLanding>

<script>
  import '../../scripts/huangli-tool';
</script>
