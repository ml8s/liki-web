---
import ScenarioLanding from '../../components/ScenarioLanding.astro';
import HuangliTool from '../../islands/HuangliTool.vue';
import { t, locales } from '../../i18n.ts';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const ns = 'scenario.huangli';
const benefits = ['structure', 'insight', 'timing', 'action'].map(key => `${ns}.benefit.${key}`);
const steps = ['s1', 's2', 's3', 's4'].map(key => `scenario.steps.${key}`);
const questions = ['q1', 'q2', 'q3'].map(key => `${ns}.${key}`);
const faqs = ['paid', 'data', 'accuracy'].map(key => ({
  questionKey: `scenario.faq.${key}.q`,
  answerKey: `scenario.faq.${key}.a`,
}));
const staticSections = ['focus', 'method', 'output'].map(key => ({
  title: t(locale, `${ns}.static.${key}.title`),
  body: t(locale, `${ns}.static.${key}.body`),
}));
const toolProps = {
  locale,
  appUrl: `/app?service=huangli&locale=${locale}`,
  labels: {
    submit: t(locale, 'tool.submit'),
    computing: t(locale, 'tool.computing'),
    error: t(locale, 'tool.error'),
    cta: t(locale, 'tool.cta'),
    privacy: t(locale, 'tool.privacy'),
  },
};
---

<ScenarioLanding
  locale={locale}
  page="huangli"
  service="huangli"
  titleKey={`${ns}.title`}
  subtitleKey={`${ns}.subtitle`}
  benefitsTitleKey={`${ns}.benefitsTitle`}
  benefitKeys={benefits}
  exampleTitleKey={`${ns}.exampleTitle`}
  stepsTitleKey="scenario.stepsTitle"
  stepKeys={steps}
  questionsTitleKey={`${ns}.questionsTitle`}
  questionKeys={questions}
  faqTitleKey="scenario.faqTitle"
  faqs={faqs}
>
  <Fragment slot="tool">
    <h2>{t(locale, 'huangli.tool.title')}</h2>
    <p>{t(locale, 'huangli.tool.intro')}</p>
    <div id="huangli-tool" data-props={JSON.stringify(toolProps)}>
    </div>
  </Fragment>
  <div class="scenario-static-index">
    {staticSections.map(section => (
      <details>
        <summary>{section.title}</summary>
        <p>{section.body}</p>
      </details>
    ))}
  </div>
  <div class="scenario-content-blocks">
    <article>
      <h3>{t(locale, 'huangli.taisui.title')}</h3>
      <p>{t(locale, 'huangli.taisui.body')}</p>
    </article>
    <article>
      <h3>{t(locale, 'huangli.daily.title')}</h3>
      <p>{t(locale, 'huangli.daily.body')}</p>
    </article>
    <article>
      <h3>{t(locale, 'huangli.calendar.title')}</h3>
      <p>{t(locale, 'huangli.calendar.body')}</p>
    </article>
    <article>
      <h3>{t(locale, 'huangli.events.title')}</h3>
      <p>{t(locale, 'huangli.events.body')}</p>
    </article>
  </div>
</ScenarioLanding>

<script>
  import '../../scripts/huangli-tool';
</script>
