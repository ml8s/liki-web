---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, locales } from '../../i18n.js';
import keywords from '../../keywords.json' with { type: 'json' };

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const skillKeywords = [...new Set(['liki.hk', 'skill', 'agent', ...keywords[locale]])];
const skillSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Liki',
  alternateName: t(locale, 'skills.hero.title'),
  url: 'https://liki.hk',
  applicationCategory: 'UtilityApplication',
  description: t(locale, 'skills.metaDesc'),
  keywords: skillKeywords.join(', '),
  hasPart: [
    { '@type': 'Service', name: t(locale, 'scenario.naming.title'), description: t(locale, 'scenario.naming.subtitle'), url: `https://liki.hk/${locale}/naming/` },
    { '@type': 'Service', name: t(locale, 'scenario.mingshu.title'), description: t(locale, 'scenario.mingshu.subtitle'), url: `https://liki.hk/${locale}/mingshu/` },
    { '@type': 'Service', name: t(locale, 'scenario.hepan.title'), description: t(locale, 'scenario.hepan.subtitle'), url: `https://liki.hk/${locale}/hepan/` },
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'hi@liki.hk',
    contactType: t(locale, 'skills.schema.contactType'),
  },
  knowsAbout: skillKeywords,
  sameAs: [
    'https://www.wikidata.org/wiki/Q140329242',
    'https://github.com/ml8s/liki',
    'https://x.com/liki_hk',
    'https://t.me/liki_naming',
    'https://zhihu.com/people/liki.hk',
    'https://www.xiaohongshu.com/user/profile/liki_hk',
  ],
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Liki',
  url: 'https://liki.hk',
  inLanguage: locale,
  about: t(locale, 'skills.metaDesc'),
};
---

<BaseLayout
  locale={locale}
  page="skills"
  heading={t(locale, 'site.brand')}
  type="brand"
  twitterCard="summary_large_image"
>
  <Fragment slot="head">
    <meta name="keywords" content={skillKeywords.join(', ')}>
    <script type="application/ld+json" set:html={JSON.stringify(skillSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </Fragment>

  <section class="hero-brand mt-8">
    <h1 class="text-center text-4xl md:text-5xl font-serif font-bold text-stone-800 tracking-tight">{t(locale, 'skills.hero.title')}</h1>
    <p class="text-center text-3xl font-serif text-stone-600 mt-4">{t(locale, 'site.slogan')}</p>
    <p class="text-center text-xl md:text-2xl text-stone-400 mt-3">{t(locale, 'skills.hero.subtitle')}</p>
  </section>

  <div class="max-w-2xl mx-auto px-4 pb-8 text-center space-y-6">
    <p class="text-xs text-stone-400 mb-2">{t(locale, 'skills.install.method1')}</p>
    <div class="install-block">
      <pre class="install-cmd">npx skills add ml8s/liki</pre>
      <button class="copy-btn" data-cmd="npx skills add ml8s/liki" aria-label={t(locale, 'skills.install.copy')}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
      </button>
    </div>
    <p class="text-xs text-stone-400 mb-2">{t(locale, 'skills.install.method2')}</p>
    <div class="install-block">
      <pre class="install-cmd">npx skills add https://liki.hk/</pre>
      <button class="copy-btn" data-cmd="npx skills add https://liki.hk/" aria-label={t(locale, 'skills.install.copy')}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
      </button>
    </div>
  </div>

  <div id="kw-bg" aria-hidden="true">
    {keywords.en.map(k => <span>{k}</span>)}
    {keywords['zh-Hans'].map(k => <span>{k}</span>)}
    {keywords['zh-Hant'].map(k => <span>{k}</span>)}
  </div>
  <script is:inline>
  (function(){
    var items = document.querySelectorAll('#kw-bg span');
    for (var i = 0; i < items.length; i++) {
      items[i].style.cssText = 'position:absolute;left:'+(Math.random()*85+7)+'%;top:'+(Math.random()*90+5)+'%;font-size:'+(12+Math.random()*14)+'px;color:#16775d;opacity:0.06;white-space:nowrap;pointer-events:none;user-select:none;transform:translateX(-50%) rotate('+(Math.random()*60-30)+'deg)';
    }
    var btns = document.querySelectorAll('.copy-btn');
    for (var i = 0; i < btns.length; i++) {
      btns[i].addEventListener('click', function() {
        var cmd = this.getAttribute('data-cmd');
        if (!cmd) return;
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(cmd).then(function() {
            var orig = this.innerHTML;
            this.innerHTML = '<span class="text-xs">✓</span>';
            var self = this;
            setTimeout(function() { self.innerHTML = orig; }, 1500);
          }.bind(this)).catch(function() {});
        }
      });
    }
  })();
  </script>
</BaseLayout>
