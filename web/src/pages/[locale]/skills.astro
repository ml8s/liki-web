---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, locales } from '../../i18n.ts';
import keywords from '../../keywords.json' with { type: 'json' };

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const skillKeywords = [...new Set(['liki.hk', 'skill', 'agent', ...(keywords as Record<string, string[]>)[locale]])];
const skillSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Liki',
  alternateName: t(locale, 'skills.hero.title'),
  url: 'https://liki.hk',
  applicationCategory: 'UtilityApplication',
  description: t(locale, 'skills.metaDesc'),
  keywords: skillKeywords.join(', '),
  hasPart: [
    { '@type': 'Service', name: t(locale, 'scenario.naming.title'), description: t(locale, 'scenario.naming.subtitle'), url: `https://liki.hk/${locale}/naming/` },
    { '@type': 'Service', name: t(locale, 'natal.title'), description: t(locale, 'natal.metaDesc'), url: `https://liki.hk/${locale}/natal/` },
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'hi@liki.hk',
    contactType: t(locale, 'skills.schema.contactType'),
  },
  knowsAbout: skillKeywords,
  sameAs: [
    'https://www.wikidata.org/wiki/Q140329242',
    'https://github.com/ml8s/liki',
    'https://x.com/liki_hk',
    'https://t.me/liki_naming',
    'https://zhihu.com/people/liki.hk',
    'https://www.xiaohongshu.com/user/profile/liki_hk',
  ],
};
---

<BaseLayout
  locale={locale}
  page="skills"
  type="brand"
  twitterCard="summary_large_image"
>
  <Fragment slot="head">
    <meta name="keywords" content={skillKeywords.join(', ')}>
    <script type="application/ld+json" set:html={JSON.stringify(skillSchema)} />
  </Fragment>

  <section class="landing-hero scenario-hero">
    <p class="landing-kicker">{t(locale, 'site.slogan')}</p>
    <h1 class="landing-h1">{t(locale, 'skills.hero.title')}</h1>
    <p class="landing-sub">{t(locale, 'skills.hero.subtitle')}</p>
  </section>

  <div class="max-w-2xl mx-auto px-4 pb-8 text-center space-y-6">
    <h2 class="font-serif">{t(locale, 'skills.install.title')}</h2>
    <p class="text-sm text-stone-400 mb-2">{t(locale, 'skills.install.method1')}</p>
    <div class="install-block">
      <pre class="install-cmd">npx skills add ml8s/liki</pre>
      <button class="copy-btn" data-cmd="npx skills add ml8s/liki" data-copied-label={t(locale, 'skills.install.copied')} aria-label={t(locale, 'skills.install.copy')}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
      </button>
      <span class="visually-hidden" role="status" aria-live="polite"></span>
    </div>
    <p class="text-sm text-stone-400 mb-2">{t(locale, 'skills.install.method2')}</p>
    <div class="install-block">
      <pre class="install-cmd">npx skills add https://liki.hk/</pre>
      <button class="copy-btn" data-cmd="npx skills add https://liki.hk/" data-copied-label={t(locale, 'skills.install.copied')} aria-label={t(locale, 'skills.install.copy')}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
      </button>
      <span class="visually-hidden" role="status" aria-live="polite"></span>
    </div>
  </div>

  <div class="max-w-2xl mx-auto px-4 pb-8 text-center space-y-6">
    <h2 class="font-serif">{t(locale, 'skills.coverage.title')}</h2>
    <p class="text-sm text-stone-400">{t(locale, 'skills.coverage.body')}</p>
  </div>

  <p class="text-center text-xs text-stone-400 pb-8 flex flex-wrap justify-center gap-x-6 gap-y-2">
    <a href="https://github.com/ml8s/liki" target="_blank" rel="noopener" class="hover:text-stone-600 transition-colors">GitHub</a>
    <a href="/llms.txt" class="hover:text-stone-600 transition-colors">llms.txt</a>
    <a href="/skills/liki/SKILL.md" class="hover:text-stone-600 transition-colors">SKILL.md</a>
  </p>
  <script>
    import '../../scripts/skills-page';
  </script>
</BaseLayout>
