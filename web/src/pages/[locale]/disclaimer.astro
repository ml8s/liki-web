---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, locales } from '../../i18n.js';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<BaseLayout
  locale={locale}
  page="disclaimer"
  heading={t(locale, 'disclaimer.heading')}
  type="article"
>
  <h1 class="sr-only">{t(locale, 'disclaimer.heading')}</h1>
  <p class="text-stone-400 text-xs mb-6">{t(locale, 'disclaimer.updated')}</p>

  <section class="mb-10">
    <h2 class="text-base font-semibold text-stone-800 mb-3">{t(locale, 'disclaimer.s1.title')}</h2>
    <p class="text-sm text-stone-400 leading-loose">{t(locale, 'disclaimer.s1.body')}</p>
  </section>
  <section class="mb-10">
    <h2 class="text-base font-semibold text-stone-800 mb-3">{t(locale, 'disclaimer.s2.title')}</h2>
    <p class="text-sm text-stone-400 leading-loose">{t(locale, 'disclaimer.s2.body')}</p>
  </section>
  <section class="mb-10">
    <h2 class="text-base font-semibold text-stone-800 mb-3">{t(locale, 'disclaimer.s3.title')}</h2>
    <p class="text-sm text-stone-400 leading-loose">{t(locale, 'disclaimer.s3.body')}</p>
  </section>
  <section class="mb-10">
    <h2 class="text-base font-semibold text-stone-800 mb-3">{t(locale, 'disclaimer.s4.title')}</h2>
    <p class="text-sm text-stone-400 leading-loose">{t(locale, 'disclaimer.s4.body')}</p>
  </section>
  <section class="mb-10">
    <h2 class="text-base font-semibold text-stone-800 mb-3">{t(locale, 'disclaimer.s5.title')}</h2>
    <p class="text-sm text-stone-400 leading-loose">{t(locale, 'disclaimer.s5.body')}</p>
  </section>
  <section class="mb-10">
    <h2 class="text-base font-semibold text-stone-800 mb-3">{t(locale, 'disclaimer.s6.title')}</h2>
    <p class="text-sm text-stone-400 leading-loose">{t(locale, 'disclaimer.s6.body')}</p>
  </section>
  <section class="mb-10">
    <h2 class="text-base font-semibold text-stone-800 mb-3">{t(locale, 'disclaimer.s7.title')}</h2>
    <p class="text-sm text-stone-400 leading-loose">{t(locale, 'disclaimer.s7.body')}</p>
  </section>
  <section class="mb-10">
    <h2 class="text-base font-semibold text-stone-800 mb-3">{t(locale, 'disclaimer.s8.title')}</h2>
    <p class="text-sm text-stone-400 leading-loose">{t(locale, 'disclaimer.s8.body')}</p>
  </section>
  <section class="mb-10">
    <h2 class="text-base font-semibold text-stone-800 mb-3">{t(locale, 'disclaimer.s9.title')}</h2>
    <p class="text-sm text-stone-400 leading-loose">{t(locale, 'disclaimer.s9.body')}</p>
  </section>
  <section>
    <h2 class="text-base font-semibold text-stone-800 mb-3">{t(locale, 'disclaimer.s10.title')}</h2>
    <p class="text-sm text-stone-400 leading-loose">{t(locale, 'disclaimer.s10.body')}</p>
  </section>
</BaseLayout>
