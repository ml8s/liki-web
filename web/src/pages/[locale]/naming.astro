---
import ScenarioLanding from '../../components/ScenarioLanding.astro';
import { t, locales } from '../../i18n.ts';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const ns = 'naming.example';
const benefits = ['birth', 'elements', 'meaning', 'review'].map(key => `scenario.naming.benefit.${key}`);
const steps = ['s1', 's2', 's3', 's4'].map(key => `scenario.steps.${key}`);
const questions = ['q1', 'q2', 'q3'].map(key => `scenario.naming.${key}`);
const faqs = ['paid', 'data', 'accuracy'].map(key => ({
  questionKey: `scenario.faq.${key}.q`,
  answerKey: `scenario.faq.${key}.a`,
}));
---

<ScenarioLanding
  locale={locale}
  page="naming"
  scenario="naming"
  titleKey="scenario.naming.title"
  subtitleKey="scenario.naming.subtitle"
  benefitsTitleKey="scenario.naming.benefitsTitle"
  benefitKeys={benefits}
  exampleTitleKey="scenario.naming.exampleTitle"
  stepsTitleKey="scenario.stepsTitle"
  stepKeys={steps}
  questionsTitleKey="scenario.naming.questionsTitle"
  questionKeys={questions}
  faqTitleKey="scenario.faqTitle"
  faqs={faqs}
>
  <div class="name-scroll scenario-name-scroll" role="list" aria-label={t(locale, 'naming.a11y.examples')} tabindex="0">
    {Array.from({length: 36}, (_, i) => {
      const n = i + 1;
      return (
        <div class="name-preview-card" role="listitem">
          <div class="name-preview-title">{t(locale, `${ns}.name${n}`)}</div>
          <div class="name-preview-gender">{t(locale, `${ns}.gender${n}`)}</div>
          <div class="name-preview-quote">{t(locale, `${ns}.quote${n}`)}</div>
          <div class="text-xs text-stone-600 mb-1">{t(locale, `${ns}.source${n}`)}</div>
          <div class="name-preview-detail">
            <span>{t(locale, `${ns}.tag${n}a`)}</span>
            <span>{t(locale, `${ns}.tag${n}b`)}</span>
            <span>{t(locale, `${ns}.tag${n}c`)}</span>
            <span>{t(locale, `${ns}.tag${n}d`)}</span>
          </div>
          <p class="text-xs text-stone-600 mt-2">{t(locale, `${ns}.footer${n}`)}</p>
        </div>
      );
    })}
  </div>
</ScenarioLanding>
