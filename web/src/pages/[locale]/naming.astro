---
import ScenarioLanding from '../../components/ScenarioLanding.astro';
import SeoTopics from '../../components/SeoTopics.astro';
import { t, locales, birthFieldLabels } from '../../i18n.ts';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const ns = 'naming.example';
const benefits = ['birth', 'elements', 'meaning', 'review'].map(key => `scenario.naming.benefit.${key}`);
const steps = ['s1', 's2', 's3', 's4'].map(key => `scenario.steps.${key}`);
const questions = ['q1', 'q2', 'q3'].map(key => `scenario.naming.${key}`);
const faqs = [
  { questionKey: 'naming.faq.bazi.q', answerKey: 'naming.faq.bazi.a' },
  { questionKey: 'naming.faq.free.q', answerKey: 'naming.faq.free.a' },
  { questionKey: 'naming.faq.gender.q', answerKey: 'naming.faq.gender.a' },
  { questionKey: 'naming.faq.rename.q', answerKey: 'naming.faq.rename.a' },
  { questionKey: 'naming.faq.score.q', answerKey: 'naming.faq.score.a' },
  { questionKey: 'naming.faq.generator.q', answerKey: 'naming.faq.generator.a' },
  { questionKey: 'scenario.faq.accuracy.q', answerKey: 'scenario.faq.accuracy.a' },
];
const cardIndexes = (from: number, to: number) => Array.from({ length: to - from + 1 }, (_, i) => from + i);
const topics = ['newborn', 'bazi', 'free', 'generator'].map(k => ({
  titleKey: `naming.scenes.${k}.title`,
  bodyKey: `naming.scenes.${k}.body`,
  ...(k === 'generator' ? {
    ctaService: 'naming',
    ctaKey: 'naming.generator.cta',
    ctaHref: `/app/birth-profiles/new?locale=${locale}`,
  } : {}),
}));
const birthLabels = birthFieldLabels(locale);
const toolProps = {
  locale,
  appUrl: `/app/birth-profiles/new?locale=${locale}`,
  labels: {
    ...birthLabels,
    submit: t(locale, 'tool.submit'),
    computing: t(locale, 'tool.computing'),
    error: t(locale, 'tool.error'),
    resultIntro: t(locale, 'naming.tool.resultIntro'),
    note: t(locale, 'naming.tool.note'),
    cta: t(locale, 'tool.cta'),
    privacy: t(locale, 'tool.privacy'),
  },
};
---

<ScenarioLanding
  locale={locale}
  page="naming"
  scenario="naming"
  titleKey="scenario.naming.title"
  subtitleKey="scenario.naming.subtitle"
  benefitsTitleKey="scenario.naming.benefitsTitle"
  benefitKeys={benefits}
  exampleTitleKey="scenario.naming.exampleTitle"
  stepsTitleKey="scenario.stepsTitle"
  stepKeys={steps}
  questionsTitleKey="scenario.naming.questionsTitle"
  questionKeys={questions}
  faqTitleKey="scenario.faqTitle"
  faqs={faqs}
>
  <Fragment slot="tool">
    <h2>{t(locale, 'naming.tool.title')}</h2>
    <p>{t(locale, 'naming.tool.intro')}</p>
    <div id="naming-tool" data-props={JSON.stringify(toolProps)}>
    </div>
  </Fragment>
  <div class="name-scroll" role="list" aria-label={t(locale, 'naming.a11y.examples')} tabindex="0">
    {cardIndexes(1, 6).map((n) => (
      <div class="name-preview-card" role="listitem">
        <div class="name-preview-title">{t(locale, `${ns}.name${n}`)}</div>
        <div class="name-preview-gender">{t(locale, `${ns}.gender${n}`)}</div>
        <div class="name-preview-quote">{t(locale, `${ns}.quote${n}`)}</div>
        <div class="text-xs text-stone-600 mb-1">{t(locale, `${ns}.source${n}`)}</div>
        <div class="name-preview-detail">
          <span>{t(locale, `${ns}.tag${n}a`)}</span>
          <span>{t(locale, `${ns}.tag${n}b`)}</span>
          <span>{t(locale, `${ns}.tag${n}c`)}</span>
          <span>{t(locale, `${ns}.tag${n}d`)}</span>
        </div>
        <p class="text-xs text-stone-600 mt-2">{t(locale, `${ns}.footer${n}`)}</p>
      </div>
    ))}
  </div>
  <details class="name-more">
    <summary>{t(locale, 'naming.examples.more')}</summary>
    <div class="name-scroll" role="list" aria-label={t(locale, 'naming.a11y.examples')} tabindex="0">
      {cardIndexes(7, 36).map((n) => (
        <div class="name-preview-card" role="listitem">
          <div class="name-preview-title">{t(locale, `${ns}.name${n}`)}</div>
          <div class="name-preview-gender">{t(locale, `${ns}.gender${n}`)}</div>
          <div class="name-preview-quote">{t(locale, `${ns}.quote${n}`)}</div>
          <div class="text-xs text-stone-600 mb-1">{t(locale, `${ns}.source${n}`)}</div>
          <div class="name-preview-detail">
            <span>{t(locale, `${ns}.tag${n}a`)}</span>
            <span>{t(locale, `${ns}.tag${n}b`)}</span>
            <span>{t(locale, `${ns}.tag${n}c`)}</span>
            <span>{t(locale, `${ns}.tag${n}d`)}</span>
          </div>
          <p class="text-xs text-stone-600 mt-2">{t(locale, `${ns}.footer${n}`)}</p>
        </div>
      ))}
    </div>
  </details>

  <div class="scenario-content-blocks">
    <h3>{t(locale, 'naming.segments.title')}</h3>
    <div class="segments-grid">
      <article>
        <h4>{t(locale, 'naming.segments.boy')}</h4>
        <p>{t(locale, 'naming.segments.boyBody')}</p>
      </article>
      <article>
        <h4>{t(locale, 'naming.segments.girl')}</h4>
        <p>{t(locale, 'naming.segments.girlBody')}</p>
      </article>
      <article>
        <h4>{t(locale, 'naming.segments.company')}</h4>
        <p>{t(locale, 'naming.segments.companyBody')}</p>
      </article>
    </div>
  </div>

  <Fragment slot="topics">
    <SeoTopics
      locale={locale}
      titleKey="naming.scenes.title"
      items={topics}
      linkHref={`/${locale}/natal/`}
      linkKey="naming.scenes.natalCta"
    />
  </Fragment>
</ScenarioLanding>

<script>
  import '../../scripts/naming-tool';
</script>
