---
import ScenarioLanding from '../../components/ScenarioLanding.astro';
import SeoTopics from '../../components/SeoTopics.astro';
import { t, locales, birthFieldLabels } from '../../i18n.ts';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const ns = 'scenario.liunian';
const benefits = ['structure', 'insight', 'timing', 'action'].map(key => `${ns}.benefit.${key}`);
const steps = ['s1', 's2', 's3', 's4'].map(key => `scenario.steps.${key}`);
const questions = ['q1', 'q2', 'q3'].map(key => `${ns}.${key}`);
const faqs = [
  { questionKey: 'liunian.faq.taisui.q', answerKey: 'liunian.faq.taisui.a' },
  { questionKey: 'liunian.faq.dayun.q', answerKey: 'liunian.faq.dayun.a' },
  { questionKey: 'liunian.faq.wealth.q', answerKey: 'liunian.faq.wealth.a' },
  { questionKey: 'scenario.faq.accuracy.q', answerKey: 'scenario.faq.accuracy.a' },
];
const topics = ['a', 'b', 'c'].map(k => ({
  titleKey: `liunian.topics.${k}.title`,
  bodyKey: `liunian.topics.${k}.body`,
}));
const staticSections = ['taisui', 'relations', 'howto'].map(key => ({
  title: t(locale, `${ns}.static.${key}.title`),
  body: t(locale, `${ns}.static.${key}.body`),
}));
const birthLabels = birthFieldLabels(locale);
const toolProps = {
  locale,
  appUrl: `/app/birth-profiles/new?locale=${locale}`,
  labels: {
    ...birthLabels,
    submit: t(locale, 'tool.submit'),
    computing: t(locale, 'tool.computing'),
    error: t(locale, 'tool.error'),
    result: t(locale, 'liunian.tool.result'),
    cta: t(locale, 'tool.cta'),
    privacy: t(locale, 'tool.privacy'),
  },
};
---

<ScenarioLanding
  locale={locale}
  page="liunian"
  scenario="liunian"
  titleKey={`${ns}.title`}
  subtitleKey={`${ns}.subtitle`}
  benefitsTitleKey={`${ns}.benefitsTitle`}
  benefitKeys={benefits}
  exampleTitleKey={`${ns}.exampleTitle`}
  stepsTitleKey="scenario.stepsTitle"
  stepKeys={steps}
  questionsTitleKey={`${ns}.questionsTitle`}
  questionKeys={questions}
  faqTitleKey="scenario.faqTitle"
  faqs={faqs}
>
  <Fragment slot="tool">
    <h2>{t(locale, 'liunian.tool.title')}</h2>
    <p>{t(locale, 'liunian.tool.intro')}</p>
    <div id="liunian-tool" data-props={JSON.stringify(toolProps)}>
    </div>
  </Fragment>
  <div class="scenario-static-index">
    {staticSections.map(section => (
      <details>
        <summary>{section.title}</summary>
        <p>{section.body}</p>
      </details>
    ))}
  </div>
  <Fragment slot="topics">
    <SeoTopics
      locale={locale}
      titleKey="liunian.topics.title"
      items={topics}
      linkHref={`/${locale}/natal/`}
      linkKey="liunian.topics.link"
    />
  </Fragment>
</ScenarioLanding>

<script>
  import '../../scripts/liunian-tool';
</script>
