---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import I18nData from '../../../components/I18nData.astro';
import { t, locales } from '../../../i18n.js';
import { v } from '../../../version.js';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<BaseLayout locale={locale} page="mingshu-report" heading={t(locale, 'site.brand')} type="brand">
  <Fragment slot="head">
    <meta name="robots" content="noindex">
    <I18nData locale={locale} />
    <link rel="stylesheet" href={`/css/app.css?v=${v}`}>
    <script defer src={`/js/api.js?v=${v}`}></script>
    <script defer src={`/js/render-report.js?v=${v}`}></script>
    <script defer src={`/js/mingshu-report.js?v=${v}`}></script>
  </Fragment>

  <main id="main" tabindex="-1">
    <div id="report-container" class="max-w-2xl mx-auto px-4">
      <div class="py-8">
        <div class="skeleton-block h-8 w-48 mb-6"></div>
        <div class="skeleton-block h-32 w-full mb-4"></div>
        <div class="skeleton-block h-32 w-full mb-4"></div>
        <div class="skeleton-block h-32 w-full mb-4"></div>
      </div>
    </div>
  </main>
</BaseLayout>
