---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t, locales } from '../../../i18n.js';
import I18nData from '../../../components/I18nData.astro';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<BaseLayout
  locale={locale}
  page="activate"
  heading={t(locale, 'site.name')}
  type="brand"
  twitterCard="summary"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex">
    <I18nData locale={locale} />
  </Fragment>

  <section class="cta-section py-8 md:py-12">
    <h2>{t(locale, 'activate.heading')}</h2>
    <p>{t(locale, 'activate.desc')}</p>
    <form id="activate-form" class="max-w-sm mx-auto mt-6" onsubmit="return false;">
      <label for="activate-code">{t(locale, 'activate.codeLabel')}</label>
      <input type="text" id="activate-code" placeholder={t(locale, 'activate.codePlaceholder')}
        class="w-full px-4 py-2.5 border border-stone-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:border-transparent mb-4"
        maxlength="11" autocomplete="off">
      <label for="activate-email">{t(locale, 'activate.emailLabel')}</label>
      <input type="email" id="activate-email" placeholder={t(locale, 'activate.emailPlaceholder')}
        class="w-full px-4 py-2.5 border border-stone-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:border-transparent mb-4"
        autocomplete="email">
      <button type="submit" id="activate-btn" class="btn-primary mb-2">
        {t(locale, 'activate.button')}
      </button>
      <a href={`/${locale}/naming/chat`} class="block w-full py-2.5 border border-stone-300 hover:border-stone-400 text-stone-800 font-medium rounded-lg transition-colors text-sm text-center">{t(locale, 'activate.returningUser')}</a>
      <p id="activate-error" class="text-red-400 text-xs mt-2 hidden" role="alert"></p>
      <p id="activate-success" class="text-green-600 text-xs mt-2 hidden">{t(locale, 'activate.success')}</p>
    </form>
  </section>

  <script is:inline>
(function () {
  var form = document.getElementById('activate-form');
  var codeInput = document.getElementById('activate-code');
  var emailInput = document.getElementById('activate-email');
  var btn = document.getElementById('activate-btn');
  var errorEl = document.getElementById('activate-error');
  var successEl = document.getElementById('activate-success');
  var t = Liki.t;
  var submitting = false;

  form.addEventListener('submit', function () {
    if (submitting) return;
    var code = codeInput.value.trim();
    var email = emailInput.value.trim();
    if (!code || !email) return;

    submitting = true;
    btn.disabled = true;
    btn.textContent = '…';
    errorEl.classList.add('hidden');
    successEl.classList.add('hidden');

    fetch('/api/naming/verification-codes/redeem', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code: code, email: email })
    }).then(function (resp) {
      return resp.json().then(function (data) { return { ok: resp.ok, status: resp.status, data: data }; });
    }).then(function (result) {
      if (result.ok) {
        successEl.classList.remove('hidden');
        var loc = Liki.localeFromPath();
        var orderID = result.data.data.order_id;
        setTimeout(function () {
          location.href = '/' + loc + '/naming/chat?order_id=' + orderID;
        }, 1000);
        return;
      }
      var msg = result.data.error ? result.data.error.message : '';
      if (!msg) {
        if (result.status === 404) msg = t('activate.errorInvalidCode');
        else if (result.status === 409) msg = t('activate.errorUsed');
        else if (result.status === 410) msg = t('activate.errorExpired');
        else msg = t('activate.errorNetwork');
      }
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
    }).catch(function () {
      errorEl.textContent = t('activate.errorNetwork');
      errorEl.classList.remove('hidden');
    }).finally(function () {
      submitting = false;
      btn.disabled = false;
      btn.textContent = t('activate.button');
    });
  });
})();
  </script>
</BaseLayout>
