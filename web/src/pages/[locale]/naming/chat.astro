---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LangSwitcher from '../../../components/LangSwitcher.astro';
import Footer from '../../../components/Footer.astro';
import { t, locales } from '../../../i18n.js';
import { v } from '../../../version.js';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const T = (key) => t(locale, key);

const jsKeys = [
  'chat.expired', 'chat.remainingDays', 'chat.remainingHours',
  'chat.thinking', 'chat.thinkingStatus', 'chat.greeting',
  'chat.sessionExpired', 'chat.orderNotPaid',
  'chat.copy',
  'chat.retry',
  'error.requestFailed',
];
const jsI18n = {};
for (const k of jsKeys) jsI18n[k] = T(k);
const i18nJSON = JSON.stringify(jsI18n);

---

<BaseLayout locale={locale} page="chat" type="bare" viewportFit={true}>
  <Fragment slot="head">
    <script is:inline set:html={`window.Liki=window.Liki||{};window.Liki.i18n=${i18nJSON};window.Liki.locale="${locale}";window.Liki.t=function(k){return window.Liki.i18n[k]||k};`}></script>
    <script defer src={`/js/marked.min.js?v=${v}`}></script>
    <script defer src={`/js/purify.min.js?v=${v}`}></script>
    <script defer src={`/js/chat.js?v=${v}`}></script>
  </Fragment>
  <div id="app">
    <!-- login view -->
    <div id="view-login" class="login-overlay">
      <div class="login-card">
        <h2>{T('chat.loginTitle')}</h2>
        <p>{T('chat.loginDesc')}</p>
        <input id="login-email" type="email" placeholder={T('chat.emailPlaceholder')} autocomplete="email">
        <button id="btn-login"><span id="login-btn-text">{T('chat.loginButton')}</span><span id="login-loading" class="login-loading hidden"><span>.</span><span>.</span><span>.</span></span></button>
        <p id="login-error" class="hidden" role="alert"></p>
        <p class="login-no-order"><a href="./">{T('chat.noOrderLink')}</a></p>
      </div>
    </div>

    <!-- select view -->
    <div id="view-select" class="select-overlay hidden">
      <div class="select-card">
        <p>{T('chat.selectDesc')}</p>
        <div id="order-list"></div>
        <p id="select-error" class="text-red-400 text-xs mt-2 hidden" role="alert"></p>
      </div>
    </div>

    <!-- chat view -->
    <div id="view-chat" class="chat-shell hidden">
      <a href="#chat-messages" class="skip-link">{T('a11y.skipLink')}</a>
      <header class="header-dark chat-header">
        <a href="./" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><polyline points="15 18 9 12 15 6"/></svg>
          {T('chat.back')}</a>
        <span class="brand"><span id="chat-heading-select" class="hidden">{T('chat.selectTitle')}</span><span id="chat-heading-chat">{T('chat.heading')}</span></span>
        <div class="flex items-center gap-2">
          <span id="chat-countdown" class="text-xs text-stone-400 hidden"></span>
          <button id="btn-reset" class="btn-header btn-newchat hidden">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
            {T('chat.reset')}</button>
          <LangSwitcher locale={locale} />
        </div>
      </header>
      <div id="chat-messages" class="chat-messages" role="log" aria-live="polite"></div>
      <div id="error-toast" class="error-toast hidden" role="alert">
        <span id="error-toast-msg"></span>
        <button id="error-toast-retry" class="text-xs text-red-400 hover:text-red-400 ml-2">{T('chat.retry')}</button>
        <button id="error-toast-close" class="text-xs text-red-400 hover:text-red-400 ml-2">&times;</button>
      </div>
      <div id="chat-input-bar" class="chat-input-bar hidden">
        <label for="chat-input" class="sr-only">{T('chat.placeholderReply')}</label>
        <input id="chat-input" type="text" placeholder={T('chat.placeholderReply')} autocomplete="off">
        <button id="btn-send" class="btn-chat-circle btn-send" aria-label={T('chat.send')}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg></button>
        <button id="btn-stop" class="btn-chat-circle btn-stop hidden" aria-label={T('chat.stop')}><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#fff"><rect x="4" y="4" width="16" height="16" rx="3"/></svg></button>
      </div>
      <div id="expired-banner" class="expired-banner hidden">
        <p>{T('chat.expired')}</p>
      </div>
      <Footer locale={locale} hideMobile />
    </div>
  </div>
  <script is:inline>
    fetch('/api/analytics/pageview', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ path: location.pathname }),
    }).catch(function(){});
  </script>
</BaseLayout>
