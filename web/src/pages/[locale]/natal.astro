---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LikiChatCta from '../../components/LikiChatCta.astro';
import MarketingHero from '../../components/marketing/MarketingHero.astro';
import FreeToolSection from '../../components/marketing/FreeToolSection.astro';
import MarketingCards from '../../components/marketing/MarketingCards.astro';
import MarketingSection from '../../components/marketing/MarketingSection.astro';
import SeoTopics from '../../components/SeoTopics.astro';
import MarketingSteps from '../../components/marketing/MarketingSteps.astro';
import MarketingQuestions from '../../components/marketing/MarketingQuestions.astro';
import MarketingFaq from '../../components/marketing/MarketingFaq.astro';
import RelatedPageCards from '../../components/marketing/RelatedPageCards.astro';
import MarketingFinalCta from '../../components/marketing/MarketingFinalCta.astro';
import { t, locales, birthFieldLabels } from '../../i18n.ts';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const ns = 'natal';
const cards = (prefix: string, keys: string[]) => keys.map(key => `${prefix}.benefit.${key}`);
const baziCards = cards('scenario.bazi', ['structure', 'insight', 'timing', 'action']);
const ziweiCards = cards(`${ns}.ziwei`, ['palaces', 'stars', 'cycles', 'career']);
const readingCards = cards('scenario.natalReading', ['personality', 'career', 'relationship', 'timing']);
const steps = ['s1', 's2', 's3', 's4'].map(key => `scenario.steps.${key}`);
const questions = [
  'scenario.bazi.q1', 'scenario.bazi.q2', 'scenario.bazi.q3',
  'scenario.natalReading.q1', 'scenario.natalReading.q2',
];
const birthLabels = birthFieldLabels(locale);
const toolProps = {
  locale,
  appUrl: `/app/birth-profiles/new?locale=${locale}`,
  labels: {
    ...birthLabels,
    submit: t(locale, 'tool.submit'),
    computing: t(locale, 'tool.computing'),
    error: t(locale, 'tool.error'),
    bazi: t(locale, 'natal.tool.bazi'),
    ziwei: t(locale, 'natal.tool.ziwei'),
    baziIntro: t(locale, 'natal.tool.baziIntro'),
    ziweiIntro: t(locale, 'natal.tool.ziweiIntro'),
    ziweiAnnualIntro: t(locale, 'natal.tool.ziweiAnnualIntro'),
    lucky: t(locale, 'natal.tool.lucky'),
    cta: t(locale, 'tool.cta'),
    privacy: t(locale, 'tool.privacy'),
  },
};
const faqs = [
  { questionKey: 'natal.faq.bazi.q', answerKey: 'natal.faq.bazi.a' },
  { questionKey: 'natal.faq.ziwei.q', answerKey: 'natal.faq.ziwei.a' },
  { questionKey: 'natal.faq.solar.q', answerKey: 'natal.faq.solar.a' },
  { questionKey: 'scenario.faq.accuracy.q', answerKey: 'scenario.faq.accuracy.a' },
];
const topics = ['a', 'b', 'c'].map(k => ({
  titleKey: `natal.topics.${k}.title`,
  bodyKey: `natal.topics.${k}.body`,
}));
const related = [
  ['liunian', 'scenario.liunian.title'],
  ['hepan', 'scenario.hepan.title'],
  ['divination', 'scenario.divination.title'],
  ['fengshui', 'scenario.fengshui.title'],
  ['huangli', 'scenario.huangli.title'],
] as const;
const faqSchema = faqs.map(item => ({
  '@type': 'Question',
  name: t(locale, item.questionKey),
  acceptedAnswer: { '@type': 'Answer', text: t(locale, item.answerKey) },
}));
const canonical = `https://liki.hk/${locale}/natal/`;
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(locale, 'site.brand'), item: `https://liki.hk/${locale}/` },
    { '@type': 'ListItem', position: 2, name: t(locale, `${ns}.heading`), item: canonical },
  ],
};
---

<BaseLayout locale={locale} page="natal" type="brand" twitterCard="summary_large_image">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: t(locale, `${ns}.title`),
      description: t(locale, `${ns}.metaDesc`),
      provider: { '@type': 'Organization', name: 'Liki', url: 'https://liki.hk' },
      serviceType: 'AI metaphysics consultation',
    })} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqSchema,
    })} />
  </Fragment>

  <MarketingHero locale={locale} titleKey={`${ns}.heading`} subtitleKey={`${ns}.subtitle`}>
    <a href="#chart-tool" class="btn-purple">{t(locale, 'scenario.cta.freeTool')}</a>
    <LikiChatCta locale={locale} service="natal" class="btn-ghost" />
    <a href="#how-it-works" class="btn-ghost">{t(locale, 'scenario.cta.secondary')}</a>
  </MarketingHero>

  <FreeToolSection
    id="chart-tool"
    title={t(locale, 'natal.tool.title')}
    intro={t(locale, 'natal.tool.intro')}
  >
    <div id="natal-tool" data-props={JSON.stringify(toolProps)}>
    </div>
  </FreeToolSection>

  <MarketingCards
    id="bazi"
    title={t(locale, 'scenario.bazi.benefitsTitle')}
    cards={baziCards.map(key => ({
      title: t(locale, `${key}.title`),
      body: t(locale, `${key}.body`),
    }))}
  />

  <MarketingCards
    id="ziwei"
    title={t(locale, `${ns}.ziwei.title`)}
    cards={ziweiCards.map(key => ({
      title: t(locale, `${key}.title`),
      body: t(locale, `${key}.body`),
    }))}
  />

  <MarketingCards
    id="reading"
    title={t(locale, 'scenario.natalReading.benefitsTitle')}
    cards={readingCards.map(key => ({
      title: t(locale, `${key}.title`),
      body: t(locale, `${key}.body`),
    }))}
  />

  <section
    id="zodiac"
    class="landing-services scenario-section"
  >
    <h2>{t(locale, `${ns}.zodiac.title`)}</h2>
    <p>{t(locale, `${ns}.zodiac.body`)}</p>
    <p><a class="card-link" href="#chart-tool">{t(locale, 'natal.zodiac.link')}</a></p>
  </section>

  <section
    id="rectification"
    class="landing-services scenario-section"
  >
    <h2>{t(locale, `${ns}.rectification.title`)}</h2>
    <p>{t(locale, `${ns}.rectification.body`)}</p>
    <p><a class="card-link" href="#chart-tool">{t(locale, 'natal.rectification.link')}</a></p>
  </section>

  <MarketingSection>
    <SeoTopics
      locale={locale}
      titleKey="natal.topics.title"
      items={topics}
      linkHref={`/${locale}/naming/`}
      linkKey="natal.topics.link"
    />
  </MarketingSection>

  <MarketingSteps title={t(locale, 'scenario.stepsTitle')} steps={steps.map(key => t(locale, key))} />

  <MarketingQuestions
    title={t(locale, 'scenario.bazi.questionsTitle')}
    questions={questions.map(key => t(locale, key))}
  />

  <MarketingFaq
    title={t(locale, 'scenario.faqTitle')}
    faqs={faqs.map(item => ({
      question: t(locale, item.questionKey),
      answer: t(locale, item.answerKey),
    }))}
  />

  <RelatedPageCards
    title={t(locale, 'natal.related.title')}
    pages={related.map(([slug, key]) => ({
      href: `/${locale}/${slug}/`,
      title: t(locale, key),
    }))}
  />

  <MarketingFinalCta label={t(locale, 'scenario.cta.bottom')}>
    <LikiChatCta locale={locale} service="natal" />
  </MarketingFinalCta>
</BaseLayout>

<script>
  import '../../scripts/natal-tool';
</script>
