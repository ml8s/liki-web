---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, locales } from '../../i18n.js';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<BaseLayout
  locale={locale}
  page="partners"
  type="brand"
  twitterCard="summary_large_image"
>
  <section class="landing-hero">
    <p class="landing-kicker">{t(locale, 'partners.heading')}</p>
    <h1 class="landing-h1">{t(locale, 'partners.hero.title')}</h1>
    <p class="landing-sub">{t(locale, 'partners.hero.subtitle')}</p>
    <div class="landing-actions">
      <a href="/app/partners" class="btn-purple">{t(locale, 'partners.cta')}</a>
    </div>
  </section>

  <section class="landing-services">
    <h2>{t(locale, 'partners.roles.title')}</h2>
    <div class="service-grid">
      <div class="card">
        <h3 class="font-serif">{t(locale, 'partners.kol.title')}</h3>
        <p>{t(locale, 'partners.kol.body')}</p>
      </div>
      <div class="card">
        <h3 class="font-serif">{t(locale, 'partners.scout.title')}</h3>
        <p>{t(locale, 'partners.scout.body')}</p>
      </div>
    </div>
  </section>

  <section class="landing-services">
    <h2>{t(locale, 'partners.rules.title')}</h2>
    <p>{t(locale, 'partners.rules.body')}</p>
    <div class="landing-actions">
      <a href="/app/partners" class="btn-purple">{t(locale, 'partners.cta')}</a>
    </div>
  </section>
</BaseLayout>
