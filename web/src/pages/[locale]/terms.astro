---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, locales } from '../../i18n.ts';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<BaseLayout
  locale={locale}
  page="terms"
  type="article"
>
  <h1 class="page-title">{t(locale, 'terms.heading')}</h1>
  <p class="text-stone-400 text-xs mb-6">{t(locale, 'terms.updated')}</p>

  <section class="mb-10">
    <h2 class="text-base font-semibold text-stone-800 mb-3">{t(locale, 'terms.s1.title')}</h2>
    <p class="text-sm text-stone-400 leading-loose">{t(locale, 'terms.s1.body')}</p>
  </section>
  <section class="mb-10">
    <h2 class="text-base font-semibold text-stone-800 mb-3">{t(locale, 'terms.s2.title')}</h2>
