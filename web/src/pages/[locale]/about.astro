---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, locales } from '../../i18n.js';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<BaseLayout
  locale={locale}
  page="about"
  type="article"
>
  <h1 class="page-title">{t(locale, 'about.heading')}</h1>

  <section class="mb-10">
    <h2 class="text-base font-semibold text-stone-800 mb-3">{t(locale, 'about.s1.title')}</h2>
    <p class="text-sm text-stone-400 leading-loose">{t(locale, 'about.s1.body')}</p>
  </section>
  <section class="mb-10">
    <h2 class="text-base font-semibold text-stone-800 mb-3">{t(locale, 'about.s2.title')}</h2>
    <p class="text-sm text-stone-400 leading-loose">{t(locale, 'about.s2.body')}</p>
  </section>
  <section class="mb-10">
    <h2 class="text-base font-semibold text-stone-800 mb-3">{t(locale, 'about.s3.title')}</h2>
    <p class="text-sm text-stone-400 leading-loose">{t(locale, 'about.s3.body')}</p>
  </section>
  <section class="mb-10">
    <h2 class="text-base font-semibold text-stone-800 mb-3">{t(locale, 'about.s4.title')}</h2>
    <p class="text-sm text-stone-400 leading-loose">{t(locale, 'about.s4.body')}</p>
  </section>
  <section class="mb-10">
    <h2 class="text-base font-semibold text-stone-800 mb-3">{t(locale, 'about.s5.title')}</h2>
    <p class="text-sm text-stone-400 leading-loose">{t(locale, 'about.s5.body')}</p>
  </section>
  <section>
    <h2 class="text-base font-semibold text-stone-800 mb-3">{t(locale, 'about.s6.title')}</h2>
    <p class="text-sm text-stone-400 leading-loose">{t(locale, 'about.s6.body')}</p>
  </section>
</BaseLayout>
