---
import IntentLanding from '../../components/IntentLanding.astro';
import SeoTopics from '../../components/SeoTopics.astro';
import { t, locales } from '../../i18n.ts';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const ns = 'intent.fengshui';
const benefits = ['structure', 'insight', 'timing', 'action'].map(key => `${ns}.benefit.${key}`);
const steps = ['s1', 's2', 's3', 's4'].map(key => `intent.steps.${key}`);
const questions = ['q1', 'q2', 'q3'].map(key => `${ns}.${key}`);
const faqs = [
  { questionKey: 'fengshui.faq.bazhai.q', answerKey: 'fengshui.faq.bazhai.a' },
  { questionKey: 'fengshui.faq.plan.q', answerKey: 'fengshui.faq.plan.a' },
  { questionKey: 'fengshui.faq.rent.q', answerKey: 'fengshui.faq.rent.a' },
  { questionKey: 'fengshui.faq.dongsi.q', answerKey: 'fengshui.faq.dongsi.a' },
  { questionKey: 'intent.faq.accuracy.q', answerKey: 'intent.faq.accuracy.a' },
];
const topics = ['a', 'b', 'c'].map(k => ({
  titleKey: `fengshui.topics.${k}.title`,
  bodyKey: `fengshui.topics.${k}.body`,
}));
const staticSections = ['focus', 'method', 'output'].map(key => ({
  title: t(locale, `${ns}.static.${key}.title`),
  body: t(locale, `${ns}.static.${key}.body`),
}));
const toolProps = {
  locale,
  appUrl: `/app?service=fengshui&locale=${locale}`,
  labels: {
    submit: t(locale, 'tool.submit'),
    computing: t(locale, 'tool.computing'),
    error: t(locale, 'tool.error'),
    bazhaiIntro: t(locale, 'fengshui.tool.bazhaiIntro'),
    xuankongIntro: t(locale, 'fengshui.tool.xuankongIntro'),
    layoutIntro: t(locale, 'fengshui.tool.layoutIntro'),
    cta: t(locale, 'tool.cta'),
    privacy: t(locale, 'tool.privacy'),
  },
};
---

<IntentLanding
  locale={locale}
  page="fengshui"
  service="fengshui"
  titleKey={`${ns}.title`}
  subtitleKey={`${ns}.subtitle`}
  benefitsTitleKey={`${ns}.benefitsTitle`}
  benefitKeys={benefits}
  exampleTitleKey={`${ns}.exampleTitle`}
  stepsTitleKey="intent.stepsTitle"
  stepKeys={steps}
  questionsTitleKey={`${ns}.questionsTitle`}
  questionKeys={questions}
  faqTitleKey="intent.faqTitle"
  faqs={faqs}
>
  <Fragment slot="tool">
    <h2>{t(locale, 'fengshui.tool.title')}</h2>
    <p>{t(locale, 'fengshui.tool.intro')}</p>
    <div id="fengshui-tool" data-props={JSON.stringify(toolProps)}>
    </div>
  </Fragment>
  <div class="intent-static-index">
    {staticSections.map(section => (
      <details>
        <summary>{section.title}</summary>
        <p>{section.body}</p>
      </details>
    ))}
  </div>
  <Fragment slot="topics">
    <SeoTopics
      locale={locale}
      titleKey="fengshui.topics.title"
      items={topics}
      linkHref={`/${locale}/huangli/`}
      linkKey="fengshui.topics.link"
    />
  </Fragment>
</IntentLanding>

<script>
  import '../../scripts/fengshui-tool';
</script>
