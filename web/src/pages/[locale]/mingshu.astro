---
import ScenarioLanding from '../../components/ScenarioLanding.astro';
import { t, locales } from '../../i18n.ts';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const benefits = ['personality', 'career', 'relationship', 'timing'].map(key => `scenario.mingshu.benefit.${key}`);
const steps = ['s1', 's2', 's3', 's4'].map(key => `scenario.steps.${key}`);
const questions = ['q1', 'q2', 'q3'].map(key => `scenario.mingshu.${key}`);
const faqs = ['paid', 'data', 'accuracy'].map(key => ({
  questionKey: `scenario.faq.${key}.q`,
  answerKey: `scenario.faq.${key}.a`,
}));
const staticSections = ['personality', 'career', 'love', 'health', 'fortune', 'milestones']
  .map(key => ({
    title: t(locale, `scenario.mingshu.static.${key}.title`),
    body: t(locale, `scenario.mingshu.static.${key}.body`),
  }));
---

<ScenarioLanding
  locale={locale}
  page="mingshu"
  scenario="mingshu"
  titleKey="scenario.mingshu.title"
  subtitleKey="scenario.mingshu.subtitle"
  benefitsTitleKey="scenario.mingshu.benefitsTitle"
  benefitKeys={benefits}
  exampleTitleKey="scenario.mingshu.exampleTitle"
  stepsTitleKey="scenario.stepsTitle"
  stepKeys={steps}
  questionsTitleKey="scenario.mingshu.questionsTitle"
  questionKeys={questions}
  faqTitleKey="scenario.faqTitle"
  faqs={faqs}
>
  <div class="scenario-static-index">
    {staticSections.map(section => (
      <details>
        <summary>{section.title}</summary>
        <p>{section.body}</p>
      </details>
    ))}
  </div>
</ScenarioLanding>
