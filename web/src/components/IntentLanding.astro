---
import BaseLayout from '../layouts/BaseLayout.astro';
import LikiChatCta from './LikiChatCta.astro';
import MarketingHero from './marketing/MarketingHero.astro';
import MarketingSection from './marketing/MarketingSection.astro';
import MarketingCards from './marketing/MarketingCards.astro';
import MarketingSteps from './marketing/MarketingSteps.astro';
import MarketingQuestions from './marketing/MarketingQuestions.astro';
import MarketingFaq from './marketing/MarketingFaq.astro';
import MarketingFinalCta from './marketing/MarketingFinalCta.astro';
import { t } from '../i18n.ts';

export interface Props {
  locale: string;
  page: string;
  intent?: string;
  service?: string;
  titleKey: string;
  subtitleKey: string;
  benefitsTitleKey: string;
  benefitKeys: string[];
  exampleTitleKey: string;
  stepsTitleKey: string;
  stepKeys: string[];
  questionsTitleKey: string;
  questionKeys: string[];
  faqTitleKey: string;
  faqs: Array<{ questionKey: string; answerKey: string }>;
}

const {
  locale,
  page,
  intent = '',
  service = '',
  titleKey,
  subtitleKey,
  benefitsTitleKey,
  benefitKeys,
  exampleTitleKey,
  stepsTitleKey,
  stepKeys,
  questionsTitleKey,
  questionKeys,
  faqTitleKey,
  faqs,
} = Astro.props;

const faqSchema = faqs.map(item => ({
  '@type': 'Question',
  name: t(locale, item.questionKey),
  acceptedAnswer: { '@type': 'Answer', text: t(locale, item.answerKey) },
}));
const canonical = `https://liki.hk/${locale}/${page}/`;
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t(locale, 'site.brand'), item: `https://liki.hk/${locale}/` },
    { '@type': 'ListItem', position: 2, name: t(locale, titleKey), item: canonical },
  ],
};
if (!intent && !service) {
  throw new Error('IntentLanding requires either intent or service');
}
---

<BaseLayout locale={locale} page={page} type="brand" twitterCard="summary_large_image">

  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: t(locale, titleKey),
      description: t(locale, subtitleKey),
      provider: { '@type': 'Organization', name: 'Liki', url: 'https://liki.hk' },
      serviceType: 'AI metaphysics consultation',
    })} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqSchema,
    })} />
  </Fragment>

  <MarketingHero locale={locale} titleKey={titleKey} subtitleKey={subtitleKey}>
    <a href="#free-tool" class="btn-purple">{t(locale, 'intent.cta.freeTool')}</a>
    <LikiChatCta
      locale={locale}
      intent={intent}
      service={service}
      class="btn-ghost"
    />
    <a href="#how-it-works" class="btn-ghost">{t(locale, 'intent.cta.secondary')}</a>
  </MarketingHero>

  {Astro.slots.has('tool') && (
    <MarketingSection id="free-tool">
      <slot name="tool" />
    </MarketingSection>
  )}

  <MarketingCards
    title={t(locale, benefitsTitleKey)}
    cards={benefitKeys.map(key => ({
      title: t(locale, `${key}.title`),
      body: t(locale, `${key}.body`),
    }))}
  />

  {Astro.slots.has('default') && (
    <MarketingSection title={t(locale, exampleTitleKey)} class="intent-example">
      <slot />
    </MarketingSection>
  )}

  <MarketingSteps title={t(locale, stepsTitleKey)} steps={stepKeys.map(key => t(locale, key))} />

  {Astro.slots.has('topics') && (
    <section class="landing-services intent-section">
      <slot name="topics" />
    </section>
  )}

  <MarketingQuestions
    title={t(locale, questionsTitleKey)}
    questions={questionKeys.map(key => t(locale, key))}
  />

  <MarketingFaq
    title={t(locale, faqTitleKey)}
    faqs={faqs.map(item => ({
      question: t(locale, item.questionKey),
      answer: t(locale, item.answerKey),
    }))}
  />

  <MarketingFinalCta label={t(locale, 'intent.cta.bottom')}>
    <LikiChatCta locale={locale} intent={intent} service={service} />
  </MarketingFinalCta>
</BaseLayout>
