---
import { t } from '../i18n.ts';

export interface Props {
  locale: string;
  scenario?: string;
  service?: string;
  labelKey?: string;
  class?: string;
}

const {
  locale,
  scenario = '',
  service = '',
  labelKey = 'scenario.cta.primary',
  class: className = 'btn-purple',
} = Astro.props;

const query = new URLSearchParams();
if (scenario) query.set('scenario', scenario);
if (service) query.set('service', service);
query.set('locale', locale);
const target = `/app?${query.toString()}`;
---

<a href={target} class={className} data-cta={scenario || service}>
  {t(locale, labelKey)}
</a>