---
import { t } from '../i18n.ts';

export interface Props {
  locale: string;
  intent?: string;
  service?: string;
  labelKey?: string;
  /** Explicit destination, for CTAs that must start at profile creation. */
  href?: string;
  class?: string;
}

const {
  locale,
  intent = '',
  service = '',
  labelKey = 'intent.cta.primary',
  href = '',
  class: className = 'btn-purple',
} = Astro.props;

const query = new URLSearchParams();
if (intent) query.set('intent', intent);
if (service) query.set('service', service);
query.set('locale', locale);
const target = href || `/app?${query.toString()}`;
---

<a href={target} class={className} data-cta={intent || service}>
  {t(locale, labelKey)}
</a>
