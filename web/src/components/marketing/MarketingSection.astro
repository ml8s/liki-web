---
interface Props {
  id?: string
  title?: string
  intro?: string
  titleClass?: string
  class?: string
}

const { id, title, intro, titleClass = 'font-serif', class: className = 'landing-services scenario-section' } = Astro.props
---

<section class={className} id={id}>
  {title && <h2 class={titleClass}>{title}</h2>}
  {intro && <p class="section-intro">{intro}</p>}
  <slot />
</section>
