---
import MarketingSection from './MarketingSection.astro'

interface Faq {
  question: string
  answer: string
}

interface Props {
  title: string
  faqs: Faq[]
}

const { title, faqs } = Astro.props
---

<MarketingSection title={title} class="intent-faq">
  {faqs.map(faq => (
    <details>
      <summary>{faq.question}</summary>
      <p>{faq.answer}</p>
    </details>
  ))}
</MarketingSection>
