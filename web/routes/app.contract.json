{
  "version": 1,
  "routes": [
    "/app",
    "/app/login",
    "/app/consultation",
    "/app/me",
    "/app/classic",
    "/app/classic/birth-profiles",
    "/app/classic/birth-profiles/new",
    "/app/classic/birth-profiles/:id",
    "/app/classic/hepan",
    "/app/classic/divination",
    "/app/classic/fengshui",
    "/app/classic/huangli",
    "/app/classic/chat",
    "/app/classic/chat/:sessionId",
    "/app/classic/orders",
    "/app/classic/partners",
    "/app/classic/partners/kol",
    "/app/classic/partners/scout",
    "/app/classic/account",
    "/app/birth-profiles",
    "/app/birth-profiles/new",
    "/app/birth-profiles/:id",
    "/app/liunian",
    "/app/naming",
    "/app/hepan",
    "/app/divination",
    "/app/fengshui",
    "/app/huangli",
    "/app/chat",
    "/app/chat/:sessionId",
    "/app/orders",
    "/app/partners",
    "/app/partners/kol",
    "/app/partners/scout",
    "/app/account",
    "/app/admin"
  ],
  "featureFlags": {
    "appFlowRedesign": "VITE_FEATURE_APP_FLOW_REDESIGN"
  },
  "queryContracts": {
    "/app": {
      "group": {
        "type": "enum",
        "values": [
          "natal",
          "divination",
          "fengshui",
          "naming"
        ],
        "required": false,
        "default": "natal"
      },
      "intent": {
        "type": "intentId",
        "required": false,
        "policy": "canonical consultation routing intent"
      },
      "service": {
        "type": "intentId",
        "required": false,
        "policy": "legacy marketing alias for intent"
      },
      "seed": {
        "type": "intentId",
        "required": false,
        "policy": "legacy app alias for intent"
      }
    }
  },
  "experiences": {
    "classic": {
      "defaultRoute": "/app/classic",
      "rollbackRoute": "/app",
      "status": "maintenance"
    },
    "consultation": {
      "defaultRoute": "/app",
      "compatibilityAliasRoute": "/app/consultation",
      "status": "preview",
      "featureFlag": "VITE_FEATURE_APP_FLOW_REDESIGN"
    }
  },
  "experienceRedirects": [
    {
      "from": "/app/account",
      "to": "/app/classic/account",
      "preserve": [
        "query",
        "hash"
      ]
    },
    {
      "from": "/app/birth-profiles",
      "to": "/app/classic/birth-profiles",
      "preserve": [
        "query",
        "hash"
      ]
    },
    {
      "from": "/app/birth-profiles/:id",
      "to": "/app/classic/birth-profiles/:id",
      "preserve": [
        "query",
        "hash"
      ]
    },
    {
      "from": "/app/birth-profiles/new",
      "to": "/app/classic/birth-profiles/new",
      "preserve": [
        "query",
        "hash"
      ]
    },
    {
      "from": "/app/chat",
      "to": "/app/classic/chat",
      "preserve": [
        "query",
        "hash"
      ]
    },
    {
      "from": "/app/chat/:sessionId",
      "to": "/app/classic/chat/:sessionId",
      "preserve": [
        "query",
        "hash"
      ]
    },
    {
      "from": "/app/consultation",
      "to": "/app",
      "preserve": [
        "query",
        "hash"
      ]
    },
    {
      "from": "/app/divination",
      "to": "/app?group=divination&intent=divination",
      "preserve": [
        "query",
        "hash"
      ]
    },
    {
      "from": "/app/fengshui",
      "to": "/app?group=fengshui&intent=fengshui",
      "preserve": [
        "query",
        "hash"
      ]
    },
    {
      "from": "/app/hepan",
      "to": "/app?group=natal&intent=hepan",
      "preserve": [
        "query",
        "hash"
      ]
    },
    {
      "from": "/app/huangli",
      "to": "/app/classic/huangli",
      "preserve": [
        "query",
        "hash"
      ]
    },
    {
      "from": "/app/liunian",
      "to": "/app?group=natal&intent=liunian",
      "preserve": [
        "query",
        "hash"
      ]
    },
    {
      "from": "/app/naming",
      "to": "/app?group=naming&intent=naming",
      "preserve": [
        "query",
        "hash"
      ]
    },
    {
      "from": "/app/orders",
      "to": "/app/classic/orders",
      "preserve": [
        "query",
        "hash"
      ]
    },
    {
      "from": "/app/partners",
      "to": "/app/classic/partners",
      "preserve": [
        "query",
        "hash"
      ]
    },
    {
      "from": "/app/partners/kol",
      "to": "/app/classic/partners/kol",
      "preserve": [
        "query",
        "hash"
      ]
    },
    {
      "from": "/app/partners/scout",
      "to": "/app/classic/partners/scout",
      "preserve": [
        "query",
        "hash"
      ]
    }
  ],
  "rollout": {
    "previewDefault": true,
    "rollback": "Set VITE_FEATURE_APP_FLOW_REDESIGN=false; /app returns to Classic.",
    "cleanupStatus": "single product; four intent groups remain consultation UI state, not product boundaries"
  }
}
