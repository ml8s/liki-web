{
  "version": 1,
  "routes": [
    "/app",
    "/app/login",
    "/app/birth-profiles",
    "/app/birth-profiles/new",
    "/app/birth-profiles/:id",
    "/app/hepan",
    "/app/divination",
    "/app/fengshui",
    "/app/huangli",
    "/app/chat",
    "/app/chat/:sessionId",
    "/app/orders",
    "/app/partners",
    "/app/partners/kol",
    "/app/partners/scout",
    "/app/account",
    "/app/admin"
  ],
  "queryContracts": {
    "/app": {
      "intent": {
        "type": "intentId",
        "required": false,
        "default": "general",
        "policy": "marketing handoff; classic dashboard owns routing"
      },
      "service": {
        "type": "intentId",
        "required": false,
        "policy": "legacy marketing alias for intent"
      },
      "seed": {
        "type": "intentId",
        "required": false,
        "policy": "legacy app alias for intent"
      }
    }
  },
  "experienceRedirects": [
    { "from": "/app/consultation", "to": "/app", "preserve": ["query", "hash"] },
    { "from": "/app/me", "to": "/app/account", "preserve": ["query", "hash"] },
    { "from": "/app/classic", "to": "/app", "preserve": ["query", "hash"] },
    { "from": "/app/classic/:path", "to": "/app/:path", "preserve": ["query", "hash"] }
  ],
  "rollout": {
    "previewDefault": false,
    "status": "retired",
    "cleanup": "Consultation dual-template UI removed; Classic is the only authenticated App IA."
  }
}
