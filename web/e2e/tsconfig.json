{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // engine-contract.spec 直接 import app 源码做引擎契约对齐，app 模块用 import.meta.env。
    "types": ["node", "astro/client"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // e2e 经 app 源码间接进入共享层，需要与 app/web 一致的 @shared 映射。
    "baseUrl": ".",
    "paths": { "@shared/*": ["../shared/*"] }
  },
  "include": ["**/*.ts"]
}
