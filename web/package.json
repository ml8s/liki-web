{
  "name": "liki-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "preview": "astro preview",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config e2e/playwright.config.ts",
    "lint": "eslint .",
    "routes:check": "node scripts/check-route-contracts.mjs && node scripts/generate-route-artifacts.mjs --check",
    "routes:generate": "node scripts/generate-route-artifacts.mjs",
    "typecheck": "astro check && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run test/",
    "lint:docs": "markdownlint-cli2 --config ../.markdownlint-cli2.jsonc \"../README.md\" \"../ARCHITECTURE.md\" \"../DOMAIN_MODEL.md\" \"../API.md\" \"../FRONTEND.md\" \"../CONTRIBUTING.md\" \"../SECURITY.md\" \\\"../BRAND.md\\\" \"../docs/**/*.md\"",
    "system:check": "node scripts/smoke.mjs --mode=smoke"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/vue": "^7.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.19.2",
    "astro": "^7.3.8",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "markdownlint-cli2": "^0.24.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16"
  },
  "engines": {
    "npm": "11.11.0",
    "node": "24.14.1"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "element-plus": "^2.14.7",
    "pinia": "^2.3.0"
  },
  "overrides": {
    "katex": "0.19.1"
  }
}
