{
  "name": "liki-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npx astro build",
    "preview": "npx astro preview",
    "test:e2e": "npx playwright test --config e2e/playwright.config.js",
    "test:e2e:ui": "npx playwright test --ui --config e2e/playwright.config.js",
    "lint": "eslint js/",
    "check:inline-scripts": "node scripts/check-inline-scripts.cjs",
    "lint:docs": "markdownlint-cli2 --config ../.markdownlint-cli2.jsonc \"../README.md\" \"../ARCHITECTURE.md\" \"../DOMAIN_MODEL.md\" \"../API.md\" \"../FRONTEND.md\" \"../LEGACY_PRODUCTS.md\" \"../CONTRIBUTING.md\" \"../SECURITY.md\" \"../docs/**/*.md\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.59.1",
    "astro": "^7.1.2",
    "eslint": "^9.38.0",
    "markdownlint-cli2": "0.23.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=24.14.1 <25"
  }
}
