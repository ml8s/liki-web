# Naming policy
#   LIKI_*          — app-owned configuration (engine, agents, data dir, skills)
#   Vendor prefixes  — third-party credentials keep their brand (DODO_, XUNHU_,
#                      ALIPAY_, RESEND_); never rename provider-published keys
#   Bare names       — only JWT_SECRET remains as a long-established infra name;
#                      do not add new bare names

# Business parameters (startup-loaded, restart to apply; validated fail-fast)
#   LIKI_CHAT_ONE_TIME_ACCESS_DAYS — Liki Chat entitlement duration per purchase (default 30)
#   LIKI_CHAT_ONE_TIME_PRICE_*_MINOR_UNITS — catalog price in ISO-4217 minor units
#                             (¥79.00 / $29.90 production baseline)
#   LIKI_CHAT_*_REVENUE_SHARE_BASIS_POINTS — referral commission
#                             shares in basis points (production 4000 / 1000;
#                             sum must not exceed 10000)
# Retention (PIPL): days before hard-deletion / purge
#   LIKI_PAYMENT_INTENT_EXPIRY_DAYS (7), LIKI_PAYMENT_NOTIFICATION_RETENTION_DAYS (90),
#   LIKI_DELETED_PROFILE_RETENTION_DAYS (30), LIKI_EXPIRED_SESSION_RETENTION_DAYS (30)

# JWT signing secret — 32+ random characters
JWT_SECRET=

# Service runtime
LIKI_HTTP_LISTEN_ADDRESS=:8081
LIKI_ADMIN_EMAIL=

# Referral payout account encryption key — 32+ random bytes
LIKI_REFERRAL_PAYOUT_ENCRYPTION_KEY=

# Resend API Key + From address (resend.com)
RESEND_API_KEY=
# From address used by transactional email.
LIKI_EMAIL_FROM_ADDRESS=

# Dodo Payments (国际卡). DODO_TEST_MODE=1 uses Dodo test mode; 0 uses live mode.
# Product IDs must belong to the selected mode.
DODO_API_KEY=
DODO_WEBHOOK_KEY=
DODO_TEST_MODE=1
# 虎皮椒支付 (微信/支付宝)
XUNHU_APPID=
XUNHU_APPSECRET=

# Alipay AI Pay voluntary payment (separate from commercial payments).
# Leave empty to disable /api/aipay. All RPC features remain free.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# Local sandbox only (for example, .alipay-sandbox.json). Leave empty in production.
ALIPAY_CONFIG_FILE=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SELLER_ID=
ALIPAY_SELLER_NAME=Liki
ALIPAY_SERVICE_ID=
# 支付宝 AI 支付沙箱建议金额（元，固定 2 位小数字符串；对齐支付宝文档命名）
ALIPAY_AIPAY_AMOUNT=

# 也可显式指定独立 URL（如经过网关/代理的场景）。
LIKI_PAYMENT_WEBHOOK_URL=

# Engine MCP used by the web BFF. The token stays server-side.
LIKI_ENGINE_MCP_URL=http://127.0.0.1:8085
LIKI_ENGINE_MCP_TOKEN=

# Billing currency is server-owned. Use explicit once ingress is fixed to one
# region; trusted-edge preserves Cloudflare regional routing.
LIKI_BILLING_CURRENCY_SOURCE=trusted-edge
LIKI_BILLING_REGION=global

# External liki-agents runtime. Each expert is its own deployment (endpoint =
# expert identity): production sets one URL per expert service. The values
# below are the single-runtime development default; LIKI_AGENTS_URL itself
# remains the fallback applied to any expert URL that is empty.
TRUSTED_PROXY_HOPS=1
LIKI_AGENTS_URL=http://127.0.0.1:8083
LIKI_AGENTS_NATAL_URL=http://127.0.0.1:8083
LIKI_AGENTS_DIVINATION_URL=http://127.0.0.1:8083
LIKI_AGENTS_FENGSHUI_URL=http://127.0.0.1:8083
LIKI_AGENTS_NAMING_URL=http://127.0.0.1:8083
LIKI_AGENTS_INTERNAL_TOKEN=
LIKI_AGENTS_TIMEOUT_SECONDS=140
# Expert ops surface port (/readyz /version /metrics), used by readiness probes.
LIKI_AGENTS_OPS_PORT=8085

# Run-completed callback receiver (Standard Webhooks secret, whsec_...).
# Required once the direct-connect web image is deployed: direct chat history
# is written by this callback. Empty leaves the receiver unregistered.
LIKI_RUN_CALLBACK_SECRET=

# Feedback agent
LIKI_FEEDBACK_API_TOKEN=

# Internal metrics endpoint token (empty disables endpoint)
LIKI_METRICS_TOKEN=

# Public HTTPS origin used for payment returns and derived webhook URLs.
LIKI_PUBLIC_BASE_URL=
# One-time Dodo price must match LIKI_CHAT_ONE_TIME_PRICE_USD_MINOR_UNITS.
DODO_PRODUCT_LIKI_CHAT_ONE_TIME=
# Recurring Dodo product owns the charged monthly price; it must match the
# catalog/display price below. Leave empty to hide subscription checkout.
DODO_PRODUCT_LIKI_CHAT_SUBSCRIPTION=
# USD 1990 minor units = $19.90 per month.
LIKI_CHAT_SUBSCRIPTION_PRICE_USD_MINOR_UNITS=1990

# Local development authentication
# 开发模式：放宽 CORS allowlist、same-origin dev 放行、验证码 DevCode 兜底。
# 生产必须为 0/留空——一个开关同时改变三处安全姿态。
LIKI_DEVELOPMENT_MODE=

# All SQLite files live in one runtime data directory:
# platform.db, profiles.db, feedback.db, liki.db, aipay.db, and referral.db
LIKI_DATA_DIR=./data

# ── 业务与合规参数（启动时加载，重启生效；越界将拒绝启动）──
# Liki Chat 权益时长（每次购买授予的天数）
LIKI_CHAT_ONE_TIME_ACCESS_DAYS=30

# 目录价（ISO-4217 minor units：分/美分）。
# 长期机制价：¥79 / 30 天；$29.90 / 30 天。
LIKI_CHAT_ONE_TIME_PRICE_CNY_MINOR_UNITS=7900
LIKI_CHAT_ONE_TIME_PRICE_USD_MINOR_UNITS=2990

# 推荐计划分成（BASIS POINTS 基点：10000 = 100%）
#   KOL 直推 40%；Scout（招募者）在其招募的 KOL 之上再分 10%
LIKI_CHAT_KOL_REVENUE_SHARE_BASIS_POINTS=4000
LIKI_CHAT_SCOUT_REVENUE_SHARE_BASIS_POINTS=1000

# 归因 cookie 有效期（天）：新账号归因到推荐人的窗口
LIKI_REFERRAL_ATTRIBUTION_TTL_DAYS=30

# ── 合规保留期（PIPL：到期物理清除）──
# 支付意图放弃过期（天）；通知发送记录保留（天）
LIKI_PAYMENT_INTENT_EXPIRY_DAYS=7
LIKI_PAYMENT_NOTIFICATION_RETENTION_DAYS=90
# 档案软删 30 天恢复窗口到期后物理清除（天）
LIKI_DELETED_PROFILE_RETENTION_DAYS=30
# 过期/撤销会话连同 ip_hash/user_agent 的保留窗（天）
LIKI_EXPIRED_SESSION_RETENTION_DAYS=30
