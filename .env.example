# JWT signing secret — 32+ random characters
JWT_SECRET=

# Service runtime
LISTEN_ADDR=:8081
ADMIN_EMAIL=

# Referral payout account encryption key — 32+ random bytes
REFERRAL_PAYOUT_SECRET=

# Resend API Key + From address (resend.com)
RESEND_API_KEY=
RESEND_FROM=
EMAIL_FROM=

# Dodo Payments (国际卡). DODO_TEST_MODE=1 uses Dodo test mode; 0 uses live mode.
# Product IDs must belong to the selected mode.
DODO_API_KEY=
DODO_WEBHOOK_KEY=
DODO_TEST_MODE=1
DODO_PRODUCT_NAMING=
DODO_PRODUCT_MINGSHU=
DODO_PRODUCT_HEPAN=

# 虎皮椒支付 (微信/支付宝)
XUNHU_APPID=
XUNHU_APPSECRET=

# Alipay AI Pay voluntary payment (separate from commercial payments).
# Leave empty to disable /api/aipay. All RPC features remain free.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# Local sandbox only (for example, .alipay-sandbox.json). Leave empty in production.
ALIPAY_CONFIG_FILE=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SELLER_ID=
ALIPAY_SELLER_NAME=Liki
ALIPAY_SERVICE_ID=
ALIPAY_AIPAY_AMOUNT=

# LLM provider used by the in-process report/chat runner
LIKI_LLM_BASE_URL=https://llmapi.paratera.com
LIKI_LLM_API_KEY=
LIKI_LLM_MODEL=
LIKI_LLM_THINKING=

# Domain — per deployment target
DOMAIN_US=
DOMAIN_CN=
RETURN_URL=
PAYMENTS_WEBHOOK_URL=https://liki.hk/api/payments/webhook

# Agent 自调平台 API 的 base URL（定盘写回用，须与监听地址一致）
LIKI_SELF_URL=http://127.0.0.1:8081
LIKI_ENGINE_URL=http://127.0.0.1:8082/jsonrpc

# External liki-agent. local keeps the existing in-process runner; agent
# routes un-profiled unified chat through the internal AG-UI service.
LIKI_AGENTS_MODE=local
TRUSTED_PROXY_HOPS=1
LIKI_AGENTS_URL=http://127.0.0.1:8083
LIKI_AGENTS_INTERNAL_TOKEN=
LIKI_AGENTS_TIMEOUT_SECONDS=140
LIKI_SKILLS_DIR=web/skills
LIKI_PROMPT_FILE=liki/SKILL.md

# Feedback agent
FEEDBACK_API_KEY=

# Internal metrics endpoint token (empty disables endpoint)
METRICS_TOKEN=

# Unified Chat product (Dodo provider SKU, required for USD checkout).
DODO_PRODUCT_LIKI_CHAT=

# Local development authentication
DEV_MODE=1

# All SQLite files live in one runtime data directory:
# platform.db, profiles.db, feedback.db, liki.db, naming.db, mingshu.db,
# hepan.db, aipay.db, and (after Phase 4) referral.db
LIKI_DATA_DIR=./data
