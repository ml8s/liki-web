# Naming policy
#   LIKI_*          — app-owned configuration (engine, agents, data dir, skills)
#   Vendor prefixes  — third-party credentials keep their brand (DODO_, XUNHU_,
#                      ALIPAY_, RESEND_); never rename provider-published keys
#   Bare names       — long-established stable infra names (JWT_SECRET,
#                      LISTEN_ADDR, RETURN_URL); do not add new bare names

# Business parameters (startup-loaded, restart to apply; validated fail-fast)
#   LIKI_ENTITLEMENT_DAYS   — Liki Chat entitlement duration per purchase (default 30)
#   LIKI_PRICE_CNY_MINOR / LIKI_PRICE_USD_MINOR — catalog price in minor units
#                             (¥1.00 / $1.00 test default; MUST be reviewed before launch)
#   LIKI_REFERRER_RATE_BPS / LIKI_RECRUITER_RATE_BPS — referral commission
#                             shares in basis points (default 5000 / 2000;
#                             sum must not exceed 10000)
# Retention (PIPL): days before hard-deletion / purge
#   LIKI_PAYMENT_PENDING_EXPIRE_DAYS (7), LIKI_NOTIFICATION_RETENTION_DAYS (90),
#   LIKI_PROFILE_RETENTION_DAYS (30), LIKI_SESSION_RETENTION_DAYS (30)

# JWT signing secret — 32+ random characters
JWT_SECRET=

# Service runtime
LISTEN_ADDR=:8081
ADMIN_EMAIL=

# Referral payout account encryption key — 32+ random bytes
REFERRAL_PAYOUT_SECRET=

# Resend API Key + From address (resend.com)
RESEND_API_KEY=
RESEND_FROM=
EMAIL_FROM=

# Dodo Payments (国际卡). DODO_TEST_MODE=1 uses Dodo test mode; 0 uses live mode.
# Product IDs must belong to the selected mode.
DODO_API_KEY=
DODO_WEBHOOK_KEY=
DODO_TEST_MODE=1
# 虎皮椒支付 (微信/支付宝)
XUNHU_APPID=
XUNHU_APPSECRET=

# Alipay AI Pay voluntary payment (separate from commercial payments).
# Leave empty to disable /api/aipay. All RPC features remain free.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# Local sandbox only (for example, .alipay-sandbox.json). Leave empty in production.
ALIPAY_CONFIG_FILE=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SELLER_ID=
ALIPAY_SELLER_NAME=Liki
ALIPAY_SERVICE_ID=
ALIPAY_AIPAY_AMOUNT=

# Domain — per deployment target
DOMAIN_US=
DOMAIN_CN=
RETURN_URL=
PAYMENTS_WEBHOOK_URL=https://liki.hk/api/payments/webhook

# Agent 自调平台 API 的 base URL
LIKI_ENGINE_URL=http://127.0.0.1:8082/jsonrpc

# Billing currency is server-owned. Use explicit once ingress is fixed to one
# region; trusted-edge preserves Cloudflare regional routing.
LIKI_CURRENCY_SOURCE=trusted-edge
LIKI_BILLING_REGION=global

# External liki-agents runtime. All Liki Chat sessions use internal AG-UI.
TRUSTED_PROXY_HOPS=1
LIKI_AGENTS_URL=http://127.0.0.1:8083
LIKI_AGENTS_INTERNAL_TOKEN=
LIKI_AGENTS_TIMEOUT_SECONDS=140

# Feedback agent
FEEDBACK_API_KEY=

# Internal metrics endpoint token (empty disables endpoint)
METRICS_TOKEN=

# Liki Chat product (Dodo provider SKU, required for USD checkout).
DODO_PRODUCT_LIKI_CHAT=

# Local development authentication
DEV_MODE=1

# All SQLite files live in one runtime data directory:
# platform.db, profiles.db, feedback.db, liki.db, aipay.db, and referral.db
LIKI_DATA_DIR=./data

# ── 业务与合规参数（启动时加载，重启生效；越界将拒绝启动）──
# Liki Chat 权益时长（每次购买授予的天数）
LIKI_ENTITLEMENT_DAYS=30

# 目录价（minor units：分）。当前为测试价，上线前必须复核！
LIKI_PRICE_CNY_MINOR=100
LIKI_PRICE_USD_MINOR=100

# 推荐计划分成（BPS 基点：10000 = 100%）
#   KOL 直推 50%；Scout（招募者）在其招募的 KOL 之上再分 20%
LIKI_REFERRER_RATE_BPS=5000
LIKI_RECRUITER_RATE_BPS=2000

# 归因 cookie 有效期（天）：新账号归因到推荐人的窗口
LIKI_ATTRIBUTION_TTL_DAYS=30

# ── 合规保留期（PIPL：到期物理清除）──
# 支付意图放弃过期（天）；通知发送记录保留（天）
LIKI_PAYMENT_PENDING_EXPIRE_DAYS=7
LIKI_NOTIFICATION_RETENTION_DAYS=90
# 档案软删 30 天恢复窗口到期后物理清除（天）
LIKI_PROFILE_RETENTION_DAYS=30
# 过期/撤销会话连同 ip_hash/user_agent 的保留窗（天）
LIKI_SESSION_RETENTION_DAYS=30
